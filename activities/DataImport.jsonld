{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://spirit-in-physics.gftd.ai/ontology#",
    "id": "@id",
    "type": "@type",
    
    "ex": "https://example.dev/ts#",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "prov": "http://www.w3.org/ns/prov#",
    
    "name": "dct:title",
    "description": "dct:description",
    "createdAt": {"@id": "dct:created", "@type": "xsd:dateTime"},
    "updatedAt": {"@id": "dct:modified", "@type": "xsd:dateTime"},
    
    "consumer": {"@id": "ex:consumer", "@type": "@id"},
    "producer": {"@id": "ex:producer", "@type": "@id"},
    "measure": {"@id": "ex:measure"},
    "rule": {"@id": "ex:rule"},
    "condition": {"@id": "ex:condition"},
    "input": {"@id": "ex:input", "@container": "@set"},
    "output": {"@id": "ex:output", "@container": "@set"}
  },
  
  "id": "https://spirit-in-physics.gftd.ai/activity/DataImport",
  "type": "ex:Activity",
  "name": {
    "en": "Data Import",
    "ja": "データインポート"
  },
  "description": {
    "en": "Activity for importing participant data from local filesystem to Supabase database. Reads consent.json, session_data.json, emotion CSV files, and physiological data, then persists them to Supabase with database-generated IDs.",
    "ja": "ローカルファイルシステムから参加者データをSupabaseデータベースにインポートする活動。consent.json、session_data.json、感情CSVファイル、生理データを読み込み、データベース生成IDでSupabaseに保存する"
  },
  "createdAt": "2025-01-04T00:00:00+09:00",
  "updatedAt": "2025-01-04T00:00:00+09:00",
  
  "producer": "https://spirit-in-physics.gftd.ai/performer/system/ResearcherApplication",
  "consumer": "https://spirit-in-physics.gftd.ai/resource/SupabaseDatabase",
  
  "input": [
    {
      "id": "https://spirit-in-physics.gftd.ai/ontology#DatasetPath",
      "type": "ex:Input",
      "description": {"en": "Path to the dataset directory containing participant data", "ja": "参加者データを含むデータセットディレクトリのパス"}
    },
    {
      "id": "https://spirit-in-physics.gftd.ai/ontology#ParticipantId",
      "type": "ex:Input",
      "description": {"en": "Participant ID to import data for", "ja": "データをインポートする参加者ID"}
    }
  ],
  
  "output": [
    {
      "id": "https://spirit-in-physics.gftd.ai/ontology#ImportResult",
      "type": "ex:Output",
      "description": {"en": "Import result including success status, imported records count", "ja": "成功状態、インポートされたレコード数を含むインポート結果"}
    }
  ],
  
  "measure": {
    "id": "https://spirit-in-physics.gftd.ai/measure/data-import",
    "type": "ex:Measure",
    "description": {"en": "Import success rate, processing time, data validation errors", "ja": "インポート成功率、処理時間、データ検証エラー"}
  },
  
  "rule": {
    "id": "https://spirit-in-physics.gftd.ai/rule/data-import",
    "type": "ex:Rule",
    "description": {"en": "All IDs must be generated by the database (UUIDs via gen_random_uuid(), serials via auto-increment). File system paths must be validated before reading. Data must be validated against schema before insertion.", "ja": "全てのIDはデータベースによって生成される必要がある（UUIDはgen_random_uuid()、シリアルは自動増分）。ファイルシステムパスは読み込む前に検証される必要がある。データは挿入前にスキーマに対して検証される必要がある"}
  },
  
  "condition": {
    "id": "https://spirit-in-physics.gftd.ai/condition/data-import",
    "type": "ex:Condition",
    "description": {"en": "Dataset directory must exist and be readable. Supabase connection must be available.", "ja": "データセットディレクトリが存在し、読み取り可能である必要がある。Supabase接続が利用可能である必要がある"}
  }
}

