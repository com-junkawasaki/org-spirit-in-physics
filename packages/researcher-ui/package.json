{
  "name": "@spirit/researcher-ui",
  "version": "0.0.1",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*",
      "svelte": "./src/components/*",
      "default": "./src/components/*"
    },
    "./utils/*": {
      "types": "./src/utils/*",
      "default": "./src/utils/*"
    }
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@threlte/core": "^8.0.0",
    "@threlte/extras": "^9.0.0",
    "three": "^0.170.0",
    "d3": "^7.0.0",
    "d3-force-3d": "^3.0.0",
    "@bufbuild/protobuf": "^1.0.0",
    "@connectrpc/connect": "^1.0.0",
    "@connectrpc/connect-web": "^1.0.0"
  },
  "devDependencies": {
    "svelte": "^5.46.1",
    "typescript": "^5.9.3",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.182.0"
  }
}
