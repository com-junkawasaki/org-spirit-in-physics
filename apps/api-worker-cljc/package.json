{
  "name": "@spirit/api-worker-cljc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "org-spirit-in-physics apps/api-worker, CLJC port (shadow-cljs :esm fetch worker)",
  "scripts": {
    "test": "shadow-cljs compile worker-test && node out/worker-tests.cjs",
    "watch-test": "shadow-cljs watch worker-test",
    "build:worker": "shadow-cljs release worker",
    "watch:worker": "shadow-cljs watch worker",
    "smoke": "node smoke.mjs",
    "verify": "shadow-cljs compile worker-test && node out/worker-tests.cjs && shadow-cljs release worker && node smoke.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply spirit-in-physics --local",
    "db:migrate:remote": "wrangler d1 migrations apply spirit-in-physics --remote"
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.3",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2"
  }
}
