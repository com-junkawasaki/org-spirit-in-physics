<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ImportPipeline" targetNamespace="http://example.com/bpmn">
  <process id="ImportPipeline" isExecutable="true">
    <startEvent id="Start" name="Start"/>

    <sequenceFlow id="flow1" sourceRef="Start" targetRef="ImportParticipants"/>

    <serviceTask id="ImportParticipants" name="Import Participants"/>
    <sequenceFlow id="flow2" sourceRef="ImportParticipants" targetRef="ImportSessions"/>

    <serviceTask id="ImportSessions" name="Import Sessions"/>
    <sequenceFlow id="flow3" sourceRef="ImportSessions" targetRef="ImportEmotions"/>

    <serviceTask id="ImportEmotions" name="Import Emotions"/>
    <sequenceFlow id="flow4" sourceRef="ImportEmotions" targetRef="CheckStatus"/>

    <serviceTask id="CheckStatus" name="Check Status"/>
    <sequenceFlow id="flow5" sourceRef="CheckStatus" targetRef="End"/>

    <endEvent id="End" name="End"/>
  </process>
</definitions>


