# Neo4j Configuration
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword
NEO4J_DATABASE=neo4j


# Hume AI Configuration
HUME_API_KEY=
HUME_CLIENT_ID=
HUME_CLIENT_SECRET=

# Shared Storage (example: for media files)
SHARED_STORAGE_PATH=/app/dataset

# Analysis Configuration
DEFAULT_MODEL_VERSION=1.0
REPORT_OUTPUT_DIR=/app/reports

# Logging
LOG_LEVEL=INFO
