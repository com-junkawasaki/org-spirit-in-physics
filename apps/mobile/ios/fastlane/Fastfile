default_platform(:ios)

# App Store Connect API Key ファイルパス
ASC_KEY_ID = "62BW4Q57AB"
ASC_ISSUER_ID = "69a6de81-326a-47e3-e053-5b8c7c11a4d1"
ASC_KEY_FILEPATH = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_62BW4Q57AB.p8")

platform :ios do
  # ==================== 開発・テスト ====================
  desc "Debug build for Simulator"
  lane :debug_sim do
    cocoapods(podfile: "App/Podfile")
    scan(
      scheme: "App",
      clean: true,
      skip_test: true,
      destination: "platform=iOS Simulator,name=iPhone 16 Pro,OS=18.6",
      buildlog_path: "./fastlane/logs"
    )
  end

  desc "Run on Simulator"
  lane :run_sim do
    xcodebuild(
      workspace: "App/App.xcworkspace",
      scheme: "App",
      configuration: "Debug",
      destination: "platform=iOS Simulator,name=iPhone 16 Pro,OS=18.6",
      build_settings: {
        "ARCHS" => "arm64",
        "ONLY_ACTIVE_ARCH" => "YES"
      }
    )
  end

  # ==================== 証明書管理 ====================
  desc "証明書とプロファイルを同期 (match)"
  lane :sync_certs do
    match(type: "appstore", readonly: true)
  end

  desc "新しい証明書とプロファイルを作成"
  lane :create_certs do
    match(type: "development", force_for_new_devices: true)
    match(type: "appstore")
  end

  # ==================== TestFlight ====================
  desc "TestFlight にアップロード"
  lane :beta do
    # プロジェクトルートパスを取得
    mobile_dir = File.expand_path("../..", __dir__)
    apps_dir = File.expand_path("..", mobile_dir)

    # Web アプリをビルド
    sh("cd #{apps_dir}/web && pnpm build")

    # Capacitor copy (assets only)
    sh("cd #{mobile_dir} && npx cap copy ios")

    # CocoaPods インストール
    cocoapods(podfile: "App/Podfile")

    # 証明書を取得
    match(type: "appstore", readonly: true)

    # ビルド番号をインクリメント
    increment_build_number(xcodeproj: "App/App.xcodeproj")

    # Archive & Export
    build_app(
      workspace: "App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "SpiritInPhysics.ipa"
    )

    # TestFlight にアップロード
    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_FILEPATH,
      in_house: false
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  # ==================== App Store ====================
  desc "App Store に提出"
  lane :release do
    # Web アプリをビルド
    Dir.chdir("../../..") do
      sh("cd web && pnpm build")
    end

    # Capacitor copy (assets only)
    Dir.chdir("..") do
      sh("npx cap copy ios")
    end

    # CocoaPods インストール
    cocoapods(podfile: "App/Podfile")

    # 証明書を取得
    match(type: "appstore", readonly: true)

    # バージョン番号を確認
    ensure_git_status_clean

    # ビルド番号をインクリメント
    increment_build_number(xcodeproj: "App/App.xcodeproj")

    # Archive & Export
    build_app(
      workspace: "App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "SpiritInPhysics.ipa",
      include_bitcode: false
    )

    # App Store Connect にアップロード
    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_FILEPATH,
      in_house: false
    )
    upload_to_app_store(
      api_key: api_key,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false
    )

    # Git タグを作成
    add_git_tag(tag: "ios/v#{get_version_number}-#{get_build_number}")
    push_git_tags
  end

  # ==================== メタデータ ====================
  desc "App Store メタデータをダウンロード"
  lane :fetch_metadata do
    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_FILEPATH,
      in_house: false
    )
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true
    )
  end

  desc "スクリーンショットをアップロード"
  lane :upload_screenshots do
    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_FILEPATH,
      in_house: false
    )
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "App Store メタデータのみをアップロード"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_FILEPATH,
      in_house: false
    )
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "審査に提出（ビルド済みの場合）"
  lane :submit_for_review do
    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_FILEPATH,
      in_house: false
    )
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "完全リリース: ビルド + メタデータアップロード + 審査提出"
  lane :full_release do
    # プロジェクトルートパスを取得
    mobile_dir = File.expand_path("../..", __dir__)
    apps_dir = File.expand_path("..", mobile_dir)

    # Web アプリをビルド
    sh("cd #{apps_dir}/web && pnpm build")

    # Capacitor copy (assets only)
    sh("cd #{mobile_dir} && npx cap copy ios")

    # CocoaPods インストール
    cocoapods(podfile: "App/Podfile")

    # 証明書を取得
    match(type: "appstore", readonly: true)

    # ビルド番号をインクリメント
    increment_build_number(xcodeproj: "App/App.xcodeproj")

    # Archive & Export
    build_app(
      workspace: "App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "SpiritInPhysics.ipa",
      include_bitcode: false
    )

    # App Store Connect にアップロード＆審査提出
    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_FILEPATH,
      in_house: false
    )
    upload_to_app_store(
      api_key: api_key,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false
    )

    # Git タグを作成
    version = get_version_number(xcodeproj: "App/App.xcodeproj")
    build = get_build_number(xcodeproj: "App/App.xcodeproj")
    add_git_tag(tag: "ios/v#{version}-#{build}")
    push_git_tags
  end

  # ==================== エラーハンドリング ====================
  error do |lane, exception|
    # Slack 通知などを設定可能
    # slack(
    #   message: "Error in lane #{lane}: #{exception.message}",
    #   success: false
    # )
  end
end
