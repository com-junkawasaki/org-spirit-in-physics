{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://spirit-in-physics.gftd.ai/pipeline#",
    "id": "@id",
    "type": "@type",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    
    "name": "rdfs:label",
    "description": "dct:description",
    "pattern": "pipeline:pattern",
    "steps": "pipeline:steps",
    "step": "pipeline:step",
    "input": "pipeline:input",
    "output": "pipeline:output",
    "errorHandling": "pipeline:errorHandling",
    "performance": "pipeline:performance",
    "stability": "pipeline:stability",
    "complexity": "pipeline:complexity",
    "latency": "pipeline:latency",
    "throughput": "pipeline:throughput",
    "reliability": "pipeline:reliability",
    "maintainability": "pipeline:maintainability",
    "scalability": "pipeline:scalability",
    "createdAt": {"@id": "dct:created", "@type": "xsd:dateTime"},
    "updatedAt": {"@id": "dct:modified", "@type": "xsd:dateTime"}
  },
  
  "@id": "https://spirit-in-physics.gftd.ai/pipeline/patterns",
  "@type": "pipeline:PipelinePatterns",
  "name": "Emotion Processing Pipeline Patterns",
  "description": "感情取得から表示、構造分析までのパイプライン設計パターン",
  "createdAt": "2025-01-16T00:00:00+09:00",
  "updatedAt": "2025-01-16T00:00:00+09:00",
  
  "patterns": [
    {
      "@id": "pipeline:pattern/1-linear",
      "name": "Linear Pipeline (順次処理)",
      "description": "各ステップを順次実行するシンプルなパイプライン",
      "complexity": 2,
      "latency": 1500,
      "throughput": 0.67,
      "reliability": 0.7,
      "maintainability": 0.9,
      "scalability": 0.5,
      "steps": [
        {"@id": "step:capture", "name": "Capture", "order": 1},
        {"@id": "step:queue", "name": "Queue", "order": 2},
        {"@id": "step:analyze", "name": "Analyze", "order": 3},
        {"@id": "step:process", "name": "Process", "order": 4},
        {"@id": "step:visualize", "name": "Visualize", "order": 5}
      ]
    },
    {
      "@id": "pipeline:pattern/2-parallel",
      "name": "Parallel Pipeline (並列処理)",
      "description": "独立したステップを並列実行してレイテンシを削減",
      "complexity": 4,
      "latency": 800,
      "throughput": 1.25,
      "reliability": 0.75,
      "maintainability": 0.7,
      "scalability": 0.8,
      "steps": [
        {"@id": "step:capture", "parallel": true},
        {"@id": "step:analyze", "parallel": true, "dependsOn": ["step:capture"]},
        {"@id": "step:structure", "parallel": true, "dependsOn": ["step:analyze"]}
      ]
    },
    {
      "@id": "pipeline:pattern/3-event-driven",
      "name": "Event-Driven Pipeline (イベント駆動)",
      "description": "イベントストリームで各ステップを接続",
      "complexity": 5,
      "latency": 600,
      "throughput": 1.5,
      "reliability": 0.8,
      "maintainability": 0.75,
      "scalability": 0.9,
      "steps": [
        {"@id": "step:capture", "event": "media:captured"},
        {"@id": "step:analyze", "event": "media:queued"},
        {"@id": "step:process", "event": "emotion:analyzed"}
      ]
    },
    {
      "@id": "pipeline:pattern/4-state-machine",
      "name": "State Machine Pipeline (状態機械)",
      "description": "状態遷移でパイプラインを管理",
      "complexity": 6,
      "latency": 700,
      "throughput": 1.2,
      "reliability": 0.85,
      "maintainability": 0.8,
      "scalability": 0.7,
      "states": [
        {"@id": "state:idle", "transitions": ["state:capturing"]},
        {"@id": "state:capturing", "transitions": ["state:analyzing", "state:error"]},
        {"@id": "state:analyzing", "transitions": ["state:processing", "state:error"]},
        {"@id": "state:processing", "transitions": ["state:visualizing", "state:error"]},
        {"@id": "state:visualizing", "transitions": ["state:idle", "state:error"]}
      ]
    },
    {
      "@id": "pipeline:pattern/5-reactive",
      "name": "Reactive Pipeline (リアクティブ)",
      "description": "RxJS/Reactive Streamsでデータフローを管理",
      "complexity": 7,
      "latency": 500,
      "throughput": 1.8,
      "reliability": 0.9,
      "maintainability": 0.85,
      "scalability": 0.95,
      "steps": [
        {"@id": "step:capture", "stream": "mediaStream$"},
        {"@id": "step:analyze", "stream": "emotionStream$"},
        {"@id": "step:visualize", "stream": "visualizationStream$"}
      ]
    },
    {
      "@id": "pipeline:pattern/6-actor",
      "name": "Actor Model Pipeline (アクターモデル)",
      "description": "アクター間でメッセージパッシング",
      "complexity": 8,
      "latency": 550,
      "throughput": 1.6,
      "reliability": 0.95,
      "maintainability": 0.7,
      "scalability": 0.98,
      "actors": [
        {"@id": "actor:capture", "messages": ["CaptureRequest", "CaptureResponse"]},
        {"@id": "actor:analyze", "messages": ["AnalyzeRequest", "AnalyzeResponse"]},
        {"@id": "actor:visualize", "messages": ["VisualizeRequest", "VisualizeResponse"]}
      ]
    },
    {
      "@id": "pipeline:pattern/7-circuit-breaker",
      "name": "Pipeline with Circuit Breaker",
      "description": "サーキットブレーカーで障害を隔離",
      "complexity": 5,
      "latency": 900,
      "throughput": 1.1,
      "reliability": 0.95,
      "maintainability": 0.8,
      "scalability": 0.75,
      "circuitBreaker": {
        "failureThreshold": 5,
        "timeout": 30000,
        "halfOpenTimeout": 60000
      }
    },
    {
      "@id": "pipeline:pattern/8-retry-backoff",
      "name": "Pipeline with Retry/Backoff",
      "description": "指数バックオフでリトライ",
      "complexity": 4,
      "latency": 1200,
      "throughput": 0.9,
      "reliability": 0.9,
      "maintainability": 0.85,
      "scalability": 0.7,
      "retry": {
        "maxAttempts": 3,
        "backoff": "exponential",
        "initialDelay": 100,
        "maxDelay": 5000
      }
    },
    {
      "@id": "pipeline:pattern/9-validation",
      "name": "Pipeline with Validation",
      "description": "各ステップでバリデーションを実行",
      "complexity": 4,
      "latency": 1000,
      "throughput": 1.0,
      "reliability": 0.92,
      "maintainability": 0.9,
      "scalability": 0.8,
      "validations": [
        {"@id": "validation:media", "step": "step:capture"},
        {"@id": "validation:emotion", "step": "step:analyze"},
        {"@id": "validation:structure", "step": "step:structure"}
      ]
    },
    {
      "@id": "pipeline:pattern/10-monitoring",
      "name": "Pipeline with Monitoring",
      "description": "各ステップをモニタリングしてメトリクス収集",
      "complexity": 6,
      "latency": 850,
      "throughput": 1.15,
      "reliability": 0.88,
      "maintainability": 0.95,
      "scalability": 0.85,
      "monitoring": {
        "metrics": ["latency", "throughput", "errorRate", "queueSize"],
        "alerting": true,
        "tracing": true
      }
    },
    {
      "@id": "pipeline:pattern/recommended",
      "name": "Recommended: Event-Driven + Validation + Monitoring",
      "description": "推奨パターン: イベント駆動 + バリデーション + モニタリングの組み合わせ",
      "complexity": 6,
      "latency": 600,
      "throughput": 1.5,
      "reliability": 0.92,
      "maintainability": 0.95,
      "scalability": 0.90,
      "combines": [
        "pipeline:pattern/3-event-driven",
        "pipeline:pattern/9-validation",
        "pipeline:pattern/10-monitoring"
      ],
      "steps": [
        {
          "@id": "step:capture",
          "name": "Capture Media",
          "event": "media:captured",
          "validation": "validation:media",
          "monitoring": true
        },
        {
          "@id": "step:analyze",
          "name": "Analyze Emotions",
          "event": "media:queued",
          "validation": "validation:emotion",
          "monitoring": true
        },
        {
          "@id": "step:process",
          "name": "Process Word Emotion",
          "event": "emotion:analyzed",
          "monitoring": true
        },
        {
          "@id": "step:complex",
          "name": "Calculate Complex Space",
          "event": "wordEmotion:processed",
          "monitoring": true
        },
        {
          "@id": "step:structure",
          "name": "Structure Analysis",
          "event": "complex:calculated",
          "validation": "validation:structure",
          "monitoring": true
        },
        {
          "@id": "step:visualize",
          "name": "Visualize",
          "event": "structure:analyzed",
          "monitoring": true
        }
      ]
    }
  ]
}

