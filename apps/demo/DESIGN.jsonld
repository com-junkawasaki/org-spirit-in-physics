      "purpose": "React integration for Astro"
    },
    {
      "@id": "demo:dependency/astro-tailwind",
      "name": "@astrojs/tailwind",
      "version": "^5.1.4",
      "purpose": "Tailwind CSS integration for Astro"
    },
    {
      "@id": "demo:dependency/react",
      "name": "react",
      "version": "^18.2.0",
      "purpose": "React UI library"
    },
    {
      "@id": "demo:dependency/react-dom",
      "name": "react-dom",
      "version": "^18.2.0",
      "purpose": "React DOM renderer"
    },
    {
      "@id": "demo:dependency/umap-js",
      "name": "umap-js",
      "version": "^1.3.1",
      "purpose": "UMAP dimensionality reduction"
    },
    {
      "@id": "demo:dependency/hume-sdk",
      "name": "@humeai/sdk",
      "version": "^0.10.0",
      "type": "optional",
      "purpose": "Hume AI SDK (optional, not currently used)"
    }
  ],
  
