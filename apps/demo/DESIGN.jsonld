{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://spirit-in-physics.gftd.ai/demo#",
    "id": "@id",
    "type": "@type",
    
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "https://schema.org/",
    
    "title": "dct:title",
    "description": "dct:description",
    "createdAt": {"@id": "dct:created", "@type": "xsd:dateTime"},
    "updatedAt": {"@id": "dct:modified", "@type": "xsd:dateTime"},
    "version": "dct:hasVersion",
    
    "component": "demo:component",
    "library": "demo:library",
    "api": "demo:api",
    "dataFlow": "demo:dataFlow",
    "stateManagement": "demo:stateManagement",
    "dependency": "demo:dependency",
    "architecture": "demo:architecture",
    "configuration": "demo:configuration",
    
    "name": "schema:name",
    "purpose": "demo:purpose",
    "responsibilities": "demo:responsibilities",
    "props": "demo:props",
    "state": "demo:state",
    "dependencies": "demo:dependencies",
    "functions": "demo:functions",
    "input": "demo:input",
    "output": "demo:output",
    "endpoint": "demo:endpoint",
    "method": "demo:method",
    "steps": "demo:steps",
    "hooks": "demo:hooks",
    "queue": "demo:queue",
    "errorHandling": "demo:errorHandling",
    "technology": "demo:technology",
    "version": "demo:version"
  },
  
  "@id": "https://spirit-in-physics.gftd.ai/demo/design",
  "@type": "demo:ApplicationDesign",
  "title": "Demo Application Design",
  "description": "Real-time emotion analysis and Complex space visualization demo application",
  "version": "0.0.1",
  "createdAt": "2025-01-15T00:00:00+09:00",
  "updatedAt": "2025-01-15T00:00:00+09:00",
  
  "architecture": {
    "@id": "demo:architecture",
    "@type": "demo:Architecture",
    "name": "SSR Architecture",
    "description": "Astro server-side rendering with React components",
    "technology": [
      {
        "@id": "demo:tech/astro",
        "name": "Astro",
        "version": "^5.15.5",
        "purpose": "SSR framework and build system"
      },
      {
        "@id": "demo:tech/react",
        "name": "React",
        "version": "^18.2.0",
        "purpose": "UI component library"
      },
      {
        "@id": "demo:tech/tailwind",
        "name": "Tailwind CSS",
        "version": "^3.4.17",
        "purpose": "Utility-first CSS framework"
      }
    ],
    "outputMode": "server",
    "server": {
      "host": "0.0.0.0",
      "port": 4322,
      "allowedHosts": [
        "demo.spirit-in-physics.orb.local",
        "localhost",
        ".orb.local"
      ]
    },
    "hmr": {
      "host": "localhost",
      "clientPort": 25271,
      "protocol": "ws",
      "watch": {
        "usePolling": true,
        "interval": 1000
      }
    }
  },
  
  "components": [
    {
      "@id": "demo:component/DemoApp",
      "@type": "demo:Component",
      "name": "DemoApp",
      "purpose": "Main orchestrator component for the demo application",
      "file": "src/components/DemoApp.tsx",
      "responsibilities": [
        "Orchestrate word display, emotion analysis, and visualization",
        "Manage MediaStream (camera and microphone)",
        "Coordinate batch processing at BPM 85 (706ms interval)",
        "Track analysis steps and demo execution steps",
        "Handle error states and recovery"
      ],
      "state": [
        {
          "name": "currentWordIndex",
          "type": "number",
          "description": "Current word index in JUNG_STIMULUS_WORDS array"
        },
        {
          "name": "isRunning",
          "type": "boolean",
          "description": "Whether the demo is currently running"
        },
        {
          "name": "wordEmotionData",
          "type": "WordEmotionData[]",
          "description": "Array of word-emotion data collected during the demo"
        },
        {
          "name": "complexData",
          "type": "ComplexSpaceData | null",
          "description": "Calculated Complex space data"
        },
        {
          "name": "structureAnalysis",
          "type": "object",
          "description": "Structure analysis results (gap areas, density regions, duplicates)"
        },
        {
          "name": "stream",
          "type": "MediaStream | null",
          "description": "MediaStream from getUserMedia (camera and microphone)"
        },
        {
          "name": "error",
          "type": "string | null",
          "description": "Error message if any error occurs"
        },
        {
          "name": "isAnalyzing",
          "type": "boolean",
          "description": "Whether emotion analysis is currently in progress"
        },
        {
          "name": "isRequestingMedia",
          "type": "boolean",
          "description": "Whether media access is being requested"
        },
        {
          "name": "analysisSteps",
          "type": "AnalysisStep[]",
          "description": "Array of analysis steps tracked for debugging"
        },
        {
          "name": "demoSteps",
          "type": "AnalysisStep[]",
          "description": "Array of demo execution steps"
        },
        {
          "name": "hasError",
          "type": "boolean",
          "description": "Whether an error has occurred that should stop execution"
        },
        {
          "name": "batchQueue",
          "type": "BatchQueueItem[]",
          "description": "Queue of items waiting for batch processing"
        },
        {
          "name": "stepOrderCounter",
          "type": "number",
          "description": "Counter for step ordering"
        }
      ],
      "hooks": [
        {
          "name": "useEffect",
          "purpose": "Request media access on mount",
          "dependencies": []
        },
        {
          "name": "useEffect",
          "purpose": "Cleanup MediaStream on unmount",
          "dependencies": ["stream"]
        },
        {
          "name": "useEffect",
          "purpose": "Word display timer (advance to next word)",
          "dependencies": ["isRunning", "currentWordIndex", "hasError"]
        },
        {
          "name": "useEffect",
          "purpose": "BPM 85 batch processing timer",
          "dependencies": ["isRunning", "batchQueue.length", "isAnalyzing"]
        }
      ],
      "functions": [
        {
          "name": "createStep",
          "type": "useCallback",
          "purpose": "Create and track analysis steps",
          "parameters": ["stepType", "stepOrder", "name", "description", "metadata"]
        },
        {
          "name": "updateStep",
          "type": "useCallback",
          "purpose": "Update analysis step status and output",
          "parameters": ["stepId", "updates"]
        },
        {
          "name": "addStepLog",
          "type": "useCallback",
          "purpose": "Add log message to analysis step",
          "parameters": ["stepId", "message"]
        },
        {
          "name": "handleWordDisplayed",
          "type": "useCallback",
          "purpose": "Handle word display event, capture video/audio and add to batch queue",
          "parameters": []
        },
        {
          "name": "handleStart",
          "type": "function",
          "purpose": "Initialize demo and start execution",
          "parameters": []
        },
        {
          "name": "handleStop",
          "type": "function",
          "purpose": "Stop demo execution",
          "parameters": []
        }
      ],
      "dependencies": [
        "WordDisplay",
        "ComplexForce3D",
        "ComplexVisualization",
        "StructureAnalysis",
        "JUNG_STIMULUS_WORDS",
        "analyzeEmotionRealtime",
        "captureVideoFrame",
        "captureAudioFrame",
        "calculateComplexSpace"
      ]
    },
    {
      "@id": "demo:component/WordDisplay",
      "@type": "demo:Component",
      "name": "WordDisplay",
      "purpose": "Display current word and play associated audio",
      "file": "src/components/WordDisplay.tsx",
      "responsibilities": [
        "Display Japanese word, English translation, and pronunciation",
        "Play audio file if available",
        "Trigger onWordDisplayed callback when word is displayed",
        "Handle audio playback errors gracefully"
      ],
      "props": [
        {
          "name": "word",
          "type": "JungWord",
          "required": true,
          "description": "Current word to display"
        },
        {
          "name": "currentIndex",
          "type": "number",
          "required": true,
          "description": "Current word index"
        },
        {
          "name": "totalWords",
          "type": "number",
          "required": true,
          "description": "Total number of words"
        },
        {
          "name": "onWordDisplayed",
          "type": "() => void",
          "required": true,
          "description": "Callback when word is displayed"
        },
        {
          "name": "autoAdvance",
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "Whether to auto-advance after displayDuration"
        },
        {
          "name": "displayDuration",
          "type": "number",
          "required": false,
          "default": 3000,
          "description": "Duration to display word in milliseconds"
        }
      ],
      "state": [
        {
          "name": "isPlaying",
          "type": "boolean",
          "description": "Whether audio is currently playing"
        }
      ],
      "hooks": [
        {
          "name": "useEffect",
          "purpose": "Handle word change, play audio, trigger callback",
          "dependencies": ["word.id", "autoAdvance", "displayDuration"]
        }
      ],
      "dependencies": ["JungWord"]
    },
    {
      "@id": "demo:component/ComplexForce3D",
      "@type": "demo:Component",
      "name": "ComplexForce3D",
      "purpose": "Display 3D Force Graph visualization using WebGPU",
      "file": "src/components/ComplexForce3D.tsx",
      "responsibilities": [
        "Render 3D Force Graph with word nodes and emotion anchors",
        "Check WebGPU availability",
        "Handle WebGPU errors gracefully",
        "Lazy load Force3DWordGraphTypeGPU component"
      ],
      "props": [
        {
          "name": "wordEmotionData",
          "type": "WordEmotionData[]",
          "required": true,
          "description": "Word-emotion data for visualization"
        },
        {
          "name": "width",
          "type": "number",
          "required": false,
          "default": 800,
          "description": "Canvas width in pixels"
        },
        {
          "name": "height",
          "type": "number",
          "required": false,
          "default": 600,
          "description": "Canvas height in pixels"
        },
        {
          "name": "springK",
          "type": "number",
          "required": false,
          "default": 2.0,
          "description": "Spring force constant"
        },
        {
          "name": "repulsionK",
          "type": "number",
          "required": false,
          "default": 2000,
          "description": "Repulsion force constant"
        },
        {
          "name": "restLength",
          "type": "number",
          "required": false,
          "default": 80,
          "description": "Rest length for spring forces"
        },
        {
          "name": "damping",
          "type": "number",
          "required": false,
          "default": 0.92,
          "description": "Damping factor"
        },
        {
          "name": "shellRadius",
          "type": "number",
          "required": false,
          "default": 300,
          "description": "Radius of emotion anchor shell"
        },
        {
          "name": "shellK",
          "type": "number",
          "required": false,
          "default": 1.5,
          "description": "Shell force constant"
        },
        {
          "name": "radialOutK",
          "type": "number",
          "required": false,
          "default": 120,
          "description": "Radial outward force constant"
        },
        {
          "name": "minSep",
          "type": "number",
          "required": false,
          "default": 80,
          "description": "Minimum separation distance"
        },
        {
          "name": "sepK",
          "type": "number",
          "required": false,
          "default": 8000,
          "description": "Separation force constant"
        }
      ],
      "state": [
        {
          "name": "webGpuAvailable",
          "type": "boolean | null",
          "description": "Whether WebGPU is available"
        },
        {
          "name": "loadError",
          "type": "Error | null",
          "description": "Error if component fails to load"
        }
      ],
      "hooks": [
        {
          "name": "useEffect",
          "purpose": "Check WebGPU availability",
          "dependencies": []
        }
      ],
      "dependencies": [
        "@spirit-in-physics/visualization-components",
        "WordEmotionData",
        "JUNG_STIMULUS_WORDS",
        "EMOTION_KEYS"
      ]
    },
    {
      "@id": "demo:component/ComplexVisualization",
      "@type": "demo:Component",
      "name": "ComplexVisualization",
      "purpose": "Display 2D Complex space visualization",
      "file": "src/components/ComplexVisualization.tsx",
      "responsibilities": [
        "Render 2D visualization of Complex space regions",
        "Display word positions and emotion clusters"
      ],
      "props": [
        {
          "name": "complexData",
          "type": "ComplexSpaceData | null",
          "required": true,
          "description": "Complex space data to visualize"
        },
        {
          "name": "width",
          "type": "number",
          "required": false,
          "default": 800,
          "description": "Canvas width in pixels"
        },
        {
          "name": "height",
          "type": "number",
          "required": false,
          "default": 600,
          "description": "Canvas height in pixels"
        }
      ],
      "dependencies": ["ComplexSpaceData"]
    },
    {
      "@id": "demo:component/StructureAnalysis",
      "@type": "demo:Component",
      "name": "StructureAnalysis",
      "purpose": "Display structure analysis results",
      "file": "src/components/StructureAnalysis.tsx",
      "responsibilities": [
        "Display gap areas in Complex space",
        "Display density regions",
        "Display duplicate word candidates",
        "Show overall density metric"
      ],
      "props": [
        {
          "name": "gapAreas",
          "type": "GapArea[]",
          "required": true,
          "description": "Array of gap areas detected"
        },
        {
          "name": "densityRegions",
          "type": "DensityRegion[]",
          "required": true,
          "description": "Array of density regions detected"
        },
        {
          "name": "duplicates",
          "type": "DuplicateCandidate[]",
          "required": true,
          "description": "Array of duplicate word candidates"
        },
        {
          "name": "overallDensity",
          "type": "number",
          "required": true,
          "description": "Overall density metric"
        }
      ],
      "dependencies": [
        "@spirit-in-physics/visualization-components"
      ]
    }
  ],
  
  "libraries": [
    {
      "@id": "demo:library/hume-realtime",
      "@type": "demo:Library",
      "name": "hume-realtime",
      "file": "src/lib/hume-realtime.ts",
      "purpose": "Hume AI emotion analysis integration",
      "functions": [
        {
          "name": "analyzeEmotionRealtime",
          "description": "Send video and audio blobs to Hume AI API and process predictions",
          "input": {
            "videoBlob": "Blob",
            "audioBlob": "Blob | undefined"
          },
          "output": {
            "emotions": "EmotionData[]",
            "timestamp": "number",
            "processingTime": "number"
          },
          "errorHandling": "Returns empty emotions array on error (graceful degradation)"
        },
        {
          "name": "captureVideoFrame",
          "description": "Capture video frame from MediaStream as Blob",
          "input": {
            "stream": "MediaStream",
            "durationMs": "number (default: 2000)"
          },
          "output": "Blob",
          "errorHandling": "Returns empty blob on error"
        },
        {
          "name": "captureAudioFrame",
          "description": "Capture audio frame from MediaStream as Blob",
          "input": {
            "stream": "MediaStream",
            "durationMs": "number (default: 2000)"
          },
          "output": "Blob | null",
          "errorHandling": "Returns null on error or unsupported MediaRecorder",
          "notes": "Handles MediaRecorder state errors, timeslice fallback, and state checking"
        },
        {
          "name": "processHumePredictions",
          "description": "Process Hume AI predictions into normalized emotion vectors",
          "input": {
            "predictions": "any[]"
          },
          "output": "EmotionData[]",
          "notes": "Handles various Hume AI API response formats (direct predictions, results[0].predictions, etc.)"
        }
      ],
      "dependencies": [
        "EmotionData",
        "normalizeEmotionName",
        "EMOTION_KEYS"
      ]
    },
    {
      "@id": "demo:library/complex-calculator",
      "@type": "demo:Library",
      "name": "complex-calculator",
      "file": "src/lib/complex-calculator.ts",
      "purpose": "Complex space calculations: C = InformationSpace × BiologicalSpace",
      "functions": [
        {
          "name": "calculateComplexSpace",
          "description": "Calculate Complex space from emotion vectors and word associations",
          "input": {
            "wordEmotionData": "WordEmotionData[]",
            "wordVectors": "Record<string, number[]> | undefined (optional, simulated if not provided)"
          },
          "output": "ComplexSpaceData",
          "algorithm": "Complex = InformationSpace × BiologicalSpace (1024d)",
          "steps": [
            "Calculate InformationSpace (512d): Word2Vec vectors + emotion vectors",
            "Calculate BiologicalSpace (512d): Physiological responses (simulated from emotion intensity)",
            "Combine to 1024d Complex space",
            "Project to 3D for visualization (simplified PCA-like projection)",
            "Detect Complex regions"
          ]
        },
        {
          "name": "calculateInformationSpace",
          "description": "Calculate InformationSpace from word-emotion associations",
          "input": {
            "wordEmotionData": "WordEmotionData[]",
            "wordVectors": "Record<string, number[]> | undefined"
          },
          "output": "number[] (512d)",
          "algorithm": "Aggregates emotion vectors per word, combines with Word2Vec vectors (simulated)"
        },
        {
          "name": "calculateBiologicalSpace",
          "description": "Calculate BiologicalSpace from emotion intensity",
          "input": {
            "wordEmotionData": "WordEmotionData[]"
          },
          "output": "number[] (512d)",
          "algorithm": "Simulates physiological responses from emotion intensity"
        },
        {
          "name": "projectTo3D",
          "description": "Project 1024d Complex vector to 3D for visualization",
          "input": {
            "complexVector": "number[] (1024d)"
          },
          "output": "[number, number, number]",
          "algorithm": "Simplified PCA-like projection"
        },
        {
          "name": "detectComplexRegions",
          "description": "Detect Complex regions in 3D space",
          "input": {
            "wordEmotionData": "WordEmotionData[]",
            "projected3D": "[number, number, number]"
          },
          "output": "ComplexRegion[]",
          "algorithm": "Clusters words based on 3D positions and emotion profiles"
        }
      ],
      "dependencies": [
        "ComplexSpaceData",
        "ComplexRegion",
        "WordEmotionData",
        "EMOTION_KEYS"
      ]
    },
    {
      "@id": "demo:library/emotion-normalization",
      "@type": "demo:Library",
      "name": "emotion-normalization",
      "file": "src/lib/emotion-normalization.ts",
      "purpose": "Normalize emotion names to EmotionKey",
      "functions": [
        {
          "name": "normalizeEmotionName",
          "description": "Normalize emotion name to EmotionKey",
          "input": {
            "name": "string"
          },
          "output": "EmotionKey | null",
          "algorithm": "Simple mapping with exact match, partial match, and valid EmotionKey check"
        }
      ],
      "types": [
        {
          "name": "EmotionKey",
          "values": ["joy", "sadness", "anger", "fear", "surprise", "disgust", "calm", "focus", "excitement", "confusion"]
        }
      ],
      "constants": [
        {
          "name": "EMOTION_KEYS",
          "type": "readonly EmotionKey[]",
          "values": ["joy", "sadness", "anger", "fear", "surprise", "disgust", "calm", "focus", "excitement", "confusion"]
        }
      ]
    },
    {
      "@id": "demo:library/jung-words",
      "@type": "demo:Library",
      "name": "jung-words",
      "file": "src/lib/jung-words.ts",
      "purpose": "Jung stimulus words data",
      "types": [
        {
          "name": "JungWord",
          "properties": [
            {
              "name": "id",
              "type": "number"
            },
            {
              "name": "japanese",
              "type": "string"
            },
            {
              "name": "english",
              "type": "string"
            },
            {
              "name": "pronunciation",
              "type": "string"
            }
          ]
        }
      ],
      "constants": [
        {
          "name": "JUNG_STIMULUS_WORDS",
          "type": "JungWord[]",
          "count": 100,
          "description": "Array of 100 Jung stimulus words"
        }
      ]
    }
  ],
  
  "apis": [
    {
      "@id": "demo:api/hume-analyze",
      "@type": "demo:API",
      "name": "Hume AI Analyze API",
      "endpoint": "/api/hume-analyze",
      "method": "POST",
      "file": "src/pages/api/hume-analyze.ts",
      "purpose": "Proxy requests to Hume AI Batch API",
      "input": {
        "type": "multipart/form-data",
        "fields": [
          {
            "name": "video",
            "type": "Blob",
            "required": true,
            "description": "Video blob (video.webm)"
          },
          {
            "name": "audio",
            "type": "Blob",
            "required": false,
            "description": "Audio blob (audio.webm)"
          }
        ]
      },
      "output": {
        "type": "application/json",
        "structure": {
          "predictions": "any[]",
          "processingTime": "number"
        }
      },
      "process": [
        {
          "step": 1,
          "name": "Get API Key",
          "description": "Retrieve HUME_API_KEY from environment variables"
        },
        {
          "step": 2,
          "name": "Prepare Models",
          "description": "Configure models (face, prosody, burst) based on available data"
        },
        {
          "step": 3,
          "name": "Create FormData",
          "description": "Create multipart/form-data with models JSON and file blobs"
        },
        {
          "step": 4,
          "name": "Submit Job",
          "description": "POST to /v0/batch/jobs endpoint"
        },
        {
          "step": 5,
          "name": "Wait for Completion",
          "description": "Poll job status every 2 seconds (max 60 seconds)"
        },
        {
          "step": 6,
          "name": "Get Predictions",
          "description": "Fetch predictions from /v0/batch/jobs/{job_id}/predictions"
        },
        {
          "step": 7,
          "name": "Process Response",
          "description": "Parse nested response structure and aggregate predictions"
        }
      ],
      "errorHandling": [
        "Check API key presence",
        "Handle 404/500 errors from Hume API",
        "Handle job failure states",
        "Handle timeout (60 seconds)"
      ],
      "dependencies": [
        "HUME_API_BASE",
        "HUME_API_KEY"
      ]
    }
  ],
  
  "dataFlow": {
    "@id": "demo:dataFlow",
    "@type": "demo:DataFlow",
    "name": "Demo Application Data Flow",
    "description": "Complete data flow from MediaStream to visualization",
    "steps": [
      {
        "@id": "demo:dataFlow/step1",
        "step": 1,
        "name": "MediaStream Acquisition",
        "description": "Request camera and microphone access via getUserMedia",
        "input": "User permission",
        "output": "MediaStream",
        "component": "DemoApp",
        "hook": "useEffect (on mount)"
      },
      {
        "@id": "demo:dataFlow/step2",
        "step": 2,
        "name": "Word Display",
        "description": "Display current word via WordDisplay component",
        "input": "JungWord from JUNG_STIMULUS_WORDS[currentWordIndex]",
        "output": "onWordDisplayed callback triggered",
        "component": "WordDisplay"
      },
      {
        "@id": "demo:dataFlow/step3",
        "step": 3,
        "name": "Video/Audio Capture",
        "description": "Capture video and audio frames from MediaStream",
        "input": "MediaStream, currentWord",
        "output": "videoBlob, audioBlob (optional)",
        "component": "DemoApp",
        "function": "handleWordDisplayed",
        "libraries": ["captureVideoFrame", "captureAudioFrame"]
      },
      {
        "@id": "demo:dataFlow/step4",
        "step": 4,
        "name": "Batch Queue",
        "description": "Add captured frames to batch queue",
        "input": "videoBlob, audioBlob, word, wordIndex, timestamp",
        "output": "BatchQueueItem added to batchQueue",
        "component": "DemoApp",
        "state": "batchQueue"
      },
      {
        "@id": "demo:dataFlow/step5",
        "step": 5,
        "name": "Batch Processing",
        "description": "Process batch queue at BPM 85 interval (706ms)",
        "input": "batchQueue items",
        "output": "Emotion analysis results",
        "component": "DemoApp",
        "hook": "useEffect (BPM 85 timer)",
        "interval": "706ms (BPM 85)"
      },
      {
        "@id": "demo:dataFlow/step6",
        "step": 6,
        "name": "Hume AI API Call",
        "description": "Send video/audio blobs to Hume AI Batch API",
        "input": "videoBlob, audioBlob",
        "output": "predictions array",
        "api": "/api/hume-analyze",
        "library": "analyzeEmotionRealtime"
      },
      {
        "@id": "demo:dataFlow/step7",
        "step": 7,
        "name": "Emotion Processing",
        "description": "Process Hume AI predictions into normalized emotions",
        "input": "predictions array",
        "output": "EmotionData[]",
        "library": "processHumePredictions"
      },
      {
        "@id": "demo:dataFlow/step8",
        "step": 8,
        "name": "Word Emotion Data Update",
        "description": "Update wordEmotionData state with new emotion data",
        "input": "EmotionData[], word, timestamp",
        "output": "WordEmotionData[] updated",
        "component": "DemoApp",
        "state": "wordEmotionData"
      },
      {
        "@id": "demo:dataFlow/step9",
        "step": 9,
        "name": "Complex Space Calculation",
        "description": "Calculate Complex space from word-emotion data",
        "input": "WordEmotionData[]",
        "output": "ComplexSpaceData",
        "library": "calculateComplexSpace",
        "component": "DemoApp",
        "state": "complexData"
      },
      {
        "@id": "demo:dataFlow/step10",
        "step": 10,
        "name": "Structure Analysis",
        "description": "Calculate structure analysis (gap areas, density regions, duplicates)",
        "input": "ComplexSpaceData",
        "output": "StructureAnalysis results",
        "component": "DemoApp",
        "state": "structureAnalysis",
        "frequency": "Every 5 words"
      },
      {
        "@id": "demo:dataFlow/step11",
        "step": 11,
        "name": "Visualization Update",
        "description": "Update 3D Force Graph and other visualizations",
        "input": "wordEmotionData, complexData, structureAnalysis",
        "output": "Rendered visualizations",
        "components": ["ComplexForce3D", "ComplexVisualization", "StructureAnalysis"]
      }
    ]
  },
  
  "stateManagement": {
    "@id": "demo:stateManagement",
    "@type": "demo:StateManagement",
    "name": "React Hooks State Management",
    "description": "State management using React hooks and batch processing queue",
    "hooks": [
      {
        "name": "useState",
        "purpose": "Manage component state",
        "states": [
          "currentWordIndex",
          "isRunning",
          "wordEmotionData",
          "complexData",
          "structureAnalysis",
          "stream",
          "error",
          "isAnalyzing",
          "isRequestingMedia",
          "analysisSteps",
          "demoSteps",
          "hasError",
          "batchQueue",
          "stepOrderCounter"
        ]
      },
      {
        "name": "useEffect",
        "purpose": "Handle side effects and lifecycle",
        "effects": [
          {
            "purpose": "Request media access on mount",
            "dependencies": []
          },
          {
            "purpose": "Cleanup MediaStream on unmount",
            "dependencies": ["stream"]
          },
          {
            "purpose": "Word display timer",
            "dependencies": ["isRunning", "currentWordIndex", "hasError"]
          },
          {
            "purpose": "BPM 85 batch processing timer",
            "dependencies": ["isRunning", "batchQueue.length", "isAnalyzing"]
          }
        ]
      },
      {
        "name": "useCallback",
        "purpose": "Memoize callback functions",
        "callbacks": [
          "createStep",
          "updateStep",
          "addStepLog",
          "handleWordDisplayed"
        ]
      }
    ],
    "queue": {
      "@id": "demo:queue/batchQueue",
      "name": "Batch Queue",
      "type": "BatchQueueItem[]",
      "purpose": "Queue items for batch processing at BPM 85",
      "itemStructure": {
        "word": "string",
        "wordIndex": "number",
        "timestamp": "number",
        "videoBlob": "Blob",
        "audioBlob": "Blob | undefined",
        "stepOrder": "number"
      },
      "processing": {
        "interval": "706ms (BPM 85)",
        "method": "setInterval in useEffect",
        "immediateProcessing": true
      }
    },
    "errorHandling": {
      "hasError": "boolean state to stop execution on critical errors",
      "error": "string | null state for error messages",
      "gracefulDegradation": "Empty emotions array returned on API errors",
      "errorRecovery": "User can restart demo after error"
    }
  },
  
  "configuration": {
    "@id": "demo:configuration",
    "@type": "demo:Configuration",
    "bpm85": {
      "interval": 706,
      "unit": "milliseconds",
      "description": "BPM 85 = 85 beats per minute = 60000ms / 85 = ~706ms per beat"
    },
    "mediaCapture": {
      "videoDuration": 2000,
      "audioDuration": 2000,
      "unit": "milliseconds"
    },
    "humeApi": {
      "pollInterval": 2000,
      "maxWaitTime": 60000,
      "unit": "milliseconds"
    },
    "wordDisplay": {
      "displayDuration": 3000,
      "autoAdvance": true,
      "unit": "milliseconds"
    },
    "structureAnalysis": {
      "frequency": "Every 5 words",
      "description": "Run structure analysis every 5 words"
    }
  },
  
  "dependencies": [
    {
      "@id": "demo:dependency/visualization-components",
      "name": "@spirit-in-physics/visualization-components",
      "type": "local package",
      "path": "packages/visualization-components",
      "purpose": "3D Force Graph and visualization components",
      "exports": [
        "Force3DWordGraphTypeGPU",
        "WordNode",
        "WordLink",
        "EMOTION_KEYS",
