---
import Layout from '../layouts/Layout.astro';
import { Button } from '../components/ui/button';
---

<Layout>
  <main class="flex min-h-screen flex-col items-center justify-center p-24 bg-gray-50 dark:bg-gray-900">
    <div class="text-center">
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-8">
        <span class="bg-clip-text text-transparent bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500">
          Spirit in Physics
        </span>
      </h1>
      <div class="flex flex-col space-y-4 items-center">
        <a href="/sign-in">
          <Button client:load className="w-64 h-12 text-base">サインイン</Button>
        </a>
        <a href="/admin">
          <Button client:load variant="outline" className="w-64 h-16 text-lg font-semibold">管理者画面</Button>
        </a>
        <a href="/steps/1">
          <Button client:load className="w-64 h-16 text-lg font-semibold">被験者画面</Button>
        </a>
      </div>
    </div>
  </main>
</Layout>

