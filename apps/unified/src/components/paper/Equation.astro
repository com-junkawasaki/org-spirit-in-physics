---
// Merkle DAG: components.equation
// KaTeX equation renderer with semantic markup
// Note: KaTeX rendering is handled by remark-math and rehype-katex in MDX

interface Props {
  id?: string;
  equation: string;
  display?: 'inline' | 'block';
  schemaId?: string;
}

const { id, equation, display = 'block', schemaId } = Astro.props;
const isBlock = display === 'block';
---

{isBlock ? (
  <div id={id} class="my-8 overflow-x-auto">
    <div class="katex-display" set:html={equation} />
  </div>
) : (
  <span id={id} class="katex-inline" set:html={equation} />
)}

