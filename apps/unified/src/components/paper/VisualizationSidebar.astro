---
// Merkle DAG: components.visualization_sidebar
// Sidebar component for visualizations and timeline that follows scroll on iPad+ screens

import type { ExperimentalData } from '../../types/paper/experimental';
import TimelineView from './TimelineView.astro';
import WordDistanceView from './WordDistanceView.astro';
import SpiritType3DVisualization from './SpiritType3DVisualization.astro';

interface Props {
  data: ExperimentalData;
}

const { data } = Astro.props;
---

<aside class="hidden md:block w-full">
  <div class="sticky top-[calc(64px+env(safe-area-inset-top,0px)+16px)] max-h-[calc(100vh-64px-env(safe-area-inset-top,0px)-32px)] overflow-y-auto pr-2">
    <!-- Timeline Visualization -->
    <div class="mb-6 p-5 bg-white/95 dark:bg-gray-800/95 backdrop-blur-xl rounded-xl shadow-sm border border-black/5 dark:border-white/10">
      <h3 class="text-[17px] font-semibold leading-[1.4] mb-4 text-gray-900 dark:text-gray-100 tracking-[-0.01em]">Timeline</h3>
      <div class="w-full overflow-x-auto flex justify-center">
        <div class="max-w-full w-full">
          <TimelineView data={data} width={360} height={300} />
        </div>
      </div>
    </div>

    <!-- Word Distance Visualization -->
    <div class="mb-6 p-5 bg-white/95 dark:bg-gray-800/95 backdrop-blur-xl rounded-xl shadow-sm border border-black/5 dark:border-white/10">
      <h3 class="text-[17px] font-semibold leading-[1.4] mb-4 text-gray-900 dark:text-gray-100 tracking-[-0.01em]">Word Distance</h3>
      <div class="w-full overflow-x-auto flex justify-center">
        <div class="max-w-full w-full">
          <WordDistanceView data={data} width={360} height={400} topK={15} />
        </div>
      </div>
    </div>

    <!-- 3D Force Graph Visualization -->
    <div class="mb-6 p-5 bg-white/95 dark:bg-gray-800/95 backdrop-blur-xl rounded-xl shadow-sm border border-black/5 dark:border-white/10">
      <h3 class="text-[17px] font-semibold leading-[1.4] mb-4 text-gray-900 dark:text-gray-100 tracking-[-0.01em]">3D Force Graph</h3>
      <div class="w-full overflow-x-auto flex justify-center">
        <div class="max-w-full w-full">
          <SpiritType3DVisualization
            data={data}
            width={360}
            height={400}
            projectionMethod="pca"
          />
        </div>
      </div>
    </div>
  </div>
</aside>

