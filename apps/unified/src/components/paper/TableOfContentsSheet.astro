---
// Merkle DAG: components.table_of_contents_sheet
// Collapsible sheet component for table of contents

interface Section {
  id: string;
  title: string;
  level: number;
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
---

<!-- Sheet Trigger Button (Mobile) -->
<button
  id="toc-mobile-trigger"
  class="md:hidden fixed top-20 left-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-3 shadow-lg flex items-center justify-between text-gray-900 dark:text-gray-100 font-medium z-50"
  aria-label="Toggle Table of Contents"
>
  <svg
    id="toc-mobile-icon"
    class="w-5 h-5 transition-transform duration-200"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
  </svg>
  <span class="ml-2">Table of Contents</span>
</button>

<!-- Desktop Trigger Button -->
<button
  id="toc-desktop-trigger"
  class="hidden md:flex fixed top-[calc(64px+env(safe-area-inset-top,0px)+16px)] left-4 bg-white/95 dark:bg-gray-800/95 backdrop-blur-xl border border-gray-200 dark:border-gray-700 rounded-xl px-3 py-2 shadow-lg items-center justify-center text-gray-900 dark:text-gray-100 font-medium z-50"
  aria-label="Toggle Table of Contents"
>
  <svg
    id="toc-desktop-icon"
    class="w-5 h-5 transition-transform duration-200"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
  </svg>
  <span id="toc-desktop-text" class="ml-2 text-sm font-medium">TOC</span>
</button>

<!-- Sheet Overlay -->
<div
  id="toc-overlay"
  class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 hidden"
  aria-hidden="true"
></div>

<!-- Sheet Content -->
<div
  id="toc-sheet"
  class="fixed top-0 left-0 bottom-0 bg-white/95 dark:bg-gray-800/95 backdrop-blur-xl rounded-r-2xl shadow-2xl border-r border-black/5 dark:border-white/10 w-[280px] md:w-[320px] h-full overflow-hidden transition-transform duration-300 ease-out -translate-x-full z-50"
>
  <!-- Sheet Header -->
  <div class="flex items-center justify-between p-4 md:p-5 border-b border-gray-200 dark:border-gray-700">
    <h3 class="text-[17px] font-semibold leading-[1.4] text-gray-900 dark:text-gray-100 tracking-[-0.01em]">
      Table of Contents
    </h3>
    <button
      id="toc-close"
      class="p-1 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100"
      aria-label="Close"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Sheet Body -->
  <div class="overflow-y-auto h-[calc(100%-64px)] p-4 md:p-5">
    <ul class="flex flex-col list-none p-0 m-0">
      {sections.map((section) => (
        <li>
          <a
            href={`#${section.id}`}
            class={`
              block text-[15px] leading-[1.5] 
              text-gray-600 dark:text-gray-400 
              hover:text-blue-600 dark:hover:text-blue-400 
              transition-colors duration-200 
              no-underline py-2 min-h-[44px] flex items-center toc-link
              ${section.level === 1 
                ? 'font-semibold pl-0' 
                : section.level === 2 
                ? 'pl-4 text-sm' 
                : 'pl-8 text-sm'
              }
            `}
          >
            {section.title}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  (function() {
    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    
    function init() {
      const mobileTrigger = document.getElementById('toc-mobile-trigger');
      const desktopTrigger = document.getElementById('toc-desktop-trigger');
      const overlay = document.getElementById('toc-overlay');
      const sheet = document.getElementById('toc-sheet');
      const closeButton = document.getElementById('toc-close');
      const mobileIcon = document.getElementById('toc-mobile-icon');
      const desktopIcon = document.getElementById('toc-desktop-icon');
      const desktopText = document.getElementById('toc-desktop-text');
      const tocLinks = document.querySelectorAll('.toc-link');
      
      if (!mobileTrigger || !desktopTrigger || !overlay || !sheet || !closeButton) {
        console.error('TableOfContentsSheet: Required elements not found');
        return;
      }
    
    let isOpen = false;
    
    // Set initial state based on screen size
    const checkScreenSize = () => {
      const shouldBeOpen = window.innerWidth >= 768;
      if (shouldBeOpen !== isOpen) {
        toggleSheet(shouldBeOpen);
      }
    };
    
    const toggleSheet = (open?: boolean) => {
      const newState = open !== undefined ? open : !isOpen;
      isOpen = newState;
      
      if (isOpen) {
        sheet.classList.remove('-translate-x-full');
        overlay.classList.remove('hidden');
        mobileIcon?.classList.add('rotate-180');
        desktopIcon?.setAttribute('d', 'M15 19l-7-7 7-7');
        desktopText?.classList.add('hidden');
      } else {
        sheet.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
        mobileIcon?.classList.remove('rotate-180');
        desktopIcon?.setAttribute('d', 'M9 5l7 7-7 7');
        desktopText?.classList.remove('hidden');
      }
    };
    
    // Initialize state
    checkScreenSize();
    
    // Event listeners
    mobileTrigger.addEventListener('click', () => toggleSheet());
    desktopTrigger.addEventListener('click', () => toggleSheet());
    overlay.addEventListener('click', () => toggleSheet(false));
    closeButton.addEventListener('click', () => toggleSheet(false));
    
    // Close sheet on mobile when clicking a link
    tocLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 768) {
          toggleSheet(false);
        }
      });
    });
    
      // Handle window resize
      window.addEventListener('resize', checkScreenSize);
    }
  })();
</script>

