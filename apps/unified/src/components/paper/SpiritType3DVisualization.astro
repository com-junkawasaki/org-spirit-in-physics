---
// Merkle DAG: components.spirit_type_3d_visualization
// 3D visualization component for Spirit Type and Ghost Pattern classification
// Note: This component now uses TimelineVisualization's 3D Force Graph generation logic
// by passing forceMode='force-3d-typegpu' to use the actual timeline data

import type { ExperimentalData } from '../../types/paper/experimental';

interface Props {
  data: ExperimentalData;
  width?: number;
  height?: number;
}

const { 
  data,
  width = 1000,
  height = 600,
} = Astro.props;

// Get participantId and sessionId from data
const participantId = data.participants.length > 0 ? data.participants[0].id : '';
const sessionId = data.sessions.length > 0 ? data.sessions[0].id : undefined;
---

<div class="spirit-type-3d-visualization">
  <div 
    id="spirit-type-3d-visualization-container"
    data-participant-id={participantId}
    data-session-id={sessionId}
    data-width={width}
    data-height={height}
    data-force-mode="force-3d-typegpu"
  ></div>
  <script>
    (async () => {
      try {
        const [{ TimelineVisualization }, ReactModule, { createRoot }] = await Promise.all([
          import('@spirit-in-physics/visualization-components'),
          import('react'),
          import('react-dom/client')
        ]);
        const React = ReactModule.default || ReactModule;
        // Set React to global scope for visualization-components
        if (typeof window !== 'undefined') {
          window.React = React;
        }
        const container = document.getElementById('spirit-type-3d-visualization-container');
        if (container) {
          const root = createRoot(container);
          root.render(React.createElement(TimelineVisualization, {
            participantId: container.dataset.participantId,
            sessionId: container.dataset.sessionId || undefined,
            width: parseInt(container.dataset.width || '1000'),
            height: parseInt(container.dataset.height || '600'),
            forceMode: container.dataset.forceMode || 'force-3d-typegpu',
            hideFilters: true
          }));
        }
      } catch (error) {
        console.error('Failed to load TimelineVisualization:', error);
      }
    })();
  </script>
</div>

<style>
  .spirit-type-3d-visualization {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>

