---
// Merkle DAG: components.interactive_word_list
// Interactive word list with filtering and sorting

import type { SpiritType, GhostPattern, WordPair } from '../../types/paper/experimental';

interface Props {
  spiritTypes: SpiritType[];
  ghostPatterns: GhostPattern[];
}

const { spiritTypes = [], ghostPatterns = [] } = Astro.props;

// Extract all word pairs
const allWordPairs: Array<WordPair & { classificationType: 'spirit-type' | 'ghost-pattern'; id: string }> = [];

spiritTypes.forEach((st) => {
  st.wordPairs.forEach((wp, wpIndex) => {
    allWordPairs.push({
      ...wp,
      classificationType: 'spirit-type',
      id: `${st.id}-${wpIndex}`,
    });
  });
});

ghostPatterns.forEach((gp) => {
  gp.wordPairs.forEach((wp, wpIndex) => {
    allWordPairs.push({
      ...wp,
      classificationType: 'ghost-pattern',
      id: `${gp.id}-${wpIndex}`,
    });
  });
});

// Prepare data for client-side filtering/sorting
const wordListData = {
  wordPairs: allWordPairs,
  totalCount: allWordPairs.length,
  spiritTypeCount: allWordPairs.filter(wp => wp.classificationType === 'spirit-type').length,
  ghostPatternCount: allWordPairs.filter(wp => wp.classificationType === 'ghost-pattern').length,
};
---

<div class="interactive-word-list" data-word-list={JSON.stringify(wordListData)}>
  <div class="mb-4">
    <h3 class="text-lg font-semibold mb-2 dark:text-gray-100">Interactive Word List</h3>
    <p class="text-sm text-gray-600 dark:text-gray-400">
      Total word pairs: {wordListData.totalCount} | 
      Spirit Types: {wordListData.spiritTypeCount} | 
      Ghost Patterns: {wordListData.ghostPatternCount}
    </p>
  </div>
  
  <div id="word-list-container" class="border rounded-lg p-4 bg-white dark:bg-gray-800 border-gray-200 dark:border-gray-700">
    <!-- Word list will be rendered here with client-side filtering/sorting -->
    <div class="text-sm text-gray-500 dark:text-gray-400 mb-4">
      <p>Client-side filtering and sorting will be implemented here.</p>
      <p class="text-xs mt-2">Features: Filter by classification type, emotion, reaction time | Sort by frequency, reaction value, reaction time | Search</p>
    </div>
    
    <div class="space-y-2 max-h-96 overflow-y-auto">
      {allWordPairs.slice(0, 20).map(wp => (
        <div 
          class={`p-2 rounded text-sm ${
            wp.classificationType === 'spirit-type' 
              ? 'bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800' 
              : 'bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800'
          }`}
        >
          <div class="flex justify-between items-center">
            <span class="font-medium dark:text-gray-100">
              {wp.stimulusWord} → {wp.responseWord}
            </span>
            <span class={`text-xs px-2 py-1 rounded ${
              wp.classificationType === 'spirit-type' 
                ? 'bg-blue-200 dark:bg-blue-800 text-blue-800 dark:text-blue-200' 
                : 'bg-red-200 dark:bg-red-800 text-red-800 dark:text-red-200'
            }`}>
              {wp.classificationType === 'spirit-type' ? 'Spirit Type' : 'Ghost Pattern'}
            </span>
          </div>
          {wp.reactionTimeMs && (
            <div class="text-xs text-gray-600 dark:text-gray-400 mt-1">
              Reaction time: {wp.reactionTimeMs}ms | 
              Probability: {wp.wordAssociationProbability.toFixed(3)}
            </div>
          )}
        </div>
      ))}
      {allWordPairs.length > 20 && (
        <div class="text-xs text-gray-500 dark:text-gray-400 text-center py-2">
          ... and {allWordPairs.length - 20} more (full list available with client-side rendering)
        </div>
      )}
    </div>
  </div>
  
  <script>
    // Client-side script for interactive filtering/sorting
    const container = document.getElementById('word-list-container');
    if (container) {
      const dataAttr = container.closest('.interactive-word-list')?.getAttribute('data-word-list');
      if (dataAttr) {
        const data = JSON.parse(dataAttr);
        console.log('Interactive Word List Data:', data);
        // Client-side filtering/sorting/search would be implemented here
      }
    }
  </script>
</div>

<style>
  .interactive-word-list {
    width: 100%;
    display: flex;
    flex-direction: column;
  }
</style>

