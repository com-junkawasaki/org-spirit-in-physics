---
// Merkle DAG: components.complex_space_3d
// Complex space 3D visualization component (1024d → 3d)

import { projectComplexSpaceTo3D, scale3DCoordinates } from '../../lib/paper/dimensionality-reduction';
import type { SpiritType, GhostPattern } from '../../types/paper/experimental';

interface Props {
  spiritTypes: SpiritType[];
  ghostPatterns: GhostPattern[];
  width?: number;
  height?: number;
  projectionMethod?: 'pca' | 'umap';
  showInformationSpace?: boolean;
  showBiologicalSpace?: boolean;
}

const {
  spiritTypes = [],
  ghostPatterns = [],
  width = 1000,
  height = 600,
  projectionMethod = 'pca',
  showInformationSpace = true,
  showBiologicalSpace = true,
} = Astro.props;

// Combine all vectors
const allVectors = [...spiritTypes, ...ghostPatterns].map(item => item.vector);

// Project to 3D
const projected3D = projectComplexSpaceTo3D(allVectors, projectionMethod);
const scaled3D = scale3DCoordinates(projected3D, { min: -200, max: 200 });

// Prepare visualization data
const visualizationData = {
  nodes: scaled3D.map((coord, index) => {
    const item = index < spiritTypes.length
      ? spiritTypes[index]
      : ghostPatterns[index - spiritTypes.length];
    const isSpiritType = index < spiritTypes.length;
    
    return {
      id: item.id,
      position: coord,
      type: isSpiritType ? 'spirit-type' : 'ghost-pattern',
      archetype: isSpiritType ? item.archetype : undefined,
      shadowType: !isSpiritType ? item.shadowType : undefined,
      geneComponent: isSpiritType ? item.geneComponent[0] : undefined,
      memeComponent: item.memeComponent[0],
      fieldComponent: item.fieldComponent[0],
    };
  }),
  projectionMethod,
  showInformationSpace,
  showBiologicalSpace,
};
---

<div class="complex-space-3d-visualization" data-visualization={JSON.stringify(visualizationData)}>
  <div class="mb-4">
    <h3 class="text-lg font-semibold mb-2">Complex Space 3D Visualization</h3>
    <p class="text-sm text-gray-600">
      Projection method: <strong>{projectionMethod.toUpperCase()}</strong> | 
      Dimensions: 1024d → 3d | 
      Total nodes: {visualizationData.nodes.length}
    </p>
  </div>
  
  <div id="complex-space-container" style={`width: ${width}px; height: ${height}px;`}>
    <!-- 3D visualization will be rendered here -->
    <div class="flex items-center justify-center h-full text-gray-500">
      <div class="text-center">
        <p class="mb-2">Complex Space 3D Visualization</p>
        <p class="text-xs">Integration with WebGPU/Three.js required for rendering</p>
      </div>
    </div>
  </div>
  
  <div class="mt-4 text-xs text-gray-500">
    <p><strong>Information Space:</strong> Semantic and linguistic vectors (Meme component)</p>
    <p><strong>Biological Space:</strong> Physiological and emotional responses (Gene component)</p>
    <p><strong>Field Space:</strong> Environmental and contextual spatial patterns (Field component)</p>
  </div>
  
  <script>
    // Client-side script for 3D rendering
    const container = document.getElementById('complex-space-container');
    if (container) {
      const dataAttr = container.closest('.complex-space-3d-visualization')?.getAttribute('data-visualization');
      if (dataAttr) {
        const data = JSON.parse(dataAttr);
        console.log('Complex Space 3D Visualization Data:', data);
        // Integration with WebGPU/Three.js would happen here
      }
    }
  </script>
</div>

<style>
  .complex-space-3d-visualization {
    width: 100%;
    display: flex;
    flex-direction: column;
  }
  
  #complex-space-container {
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    background: #f9fafb;
    position: relative;
  }
</style>

