---
// Merkle DAG: components.timeline_view
// Timeline view component for research app

import type { ExperimentalData } from '../../types/paper/experimental';

interface Props {
  data: ExperimentalData;
  width?: number;
  height?: number;
}

const { data, width = 1000, height = 400 } = Astro.props;

// Default participantId (hardcoded for paper app)
const DEFAULT_PARTICIPANT_ID = '15592cdb-86cf-4baf-86f5-66184169ee39';

// Get participantId and sessionId from data
// Priority: data.participants[0]?.id > hardcoded ID
const participantId = data.participants[0]?.id || DEFAULT_PARTICIPANT_ID;
const sessionId = data.sessions.length > 0 && data.sessions[0] ? data.sessions[0].id : undefined;
---

<div class="timeline-view">
  <div id="timeline-visualization-container" data-participant-id={participantId} data-session-id={sessionId} data-width={width} data-height={height}></div>
  <script>
    (async () => {
      try {
        const [{ TimelineVisualization }, ReactModule, { createRoot }] = await Promise.all([
          import('@spirit-in-physics/visualization-components'),
          import('react'),
          import('react-dom/client')
        ]);
        const React = ReactModule.default || ReactModule;
        // Set React to global scope for visualization-components
        if (typeof window !== 'undefined') {
          window.React = React;
        }
        const container = document.getElementById('timeline-visualization-container');
        if (container && container.dataset.participantId) {
          const root = createRoot(container);
          const props: any = {
            participantId: container.dataset.participantId,
            width: parseInt(container.dataset.width || '1000'),
            height: parseInt(container.dataset.height || '400'),
            hideFilters: true
          };
          if (container.dataset.sessionId) {
            props.sessionId = container.dataset.sessionId;
          }
          root.render(React.createElement(TimelineVisualization, props));
        }
      } catch (error) {
        console.error('Failed to load TimelineVisualization:', error);
      }
    })();
  </script>
</div>

<style>
  .timeline-view {
    width: 100%;
  }
</style>

