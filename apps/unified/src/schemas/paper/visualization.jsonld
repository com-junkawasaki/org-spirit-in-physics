{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://spirit-in-physics.gftd.ai/research#",
    "id": "@id",
    "type": "@type",
    
    "dct": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/",
    
    "title": "dct:title",
    "description": "dct:description",
    "createdAt": {"@id": "dct:created", "@type": "xsd:dateTime"},
    "updatedAt": {"@id": "dct:modified", "@type": "xsd:dateTime"},
    
    "hasParameter": {"@id": "https://spirit-in-physics.gftd.ai/research#hasParameter"},
    "usesTechnology": {"@id": "https://spirit-in-physics.gftd.ai/research#usesTechnology"},
    "visualizes": {"@id": "https://spirit-in-physics.gftd.ai/research#visualizes", "@type": "@id"}
  },
  
  "@graph": [
    {
      "@id": "https://spirit-in-physics.gftd.ai/research/visualizations/3d-force-graph",
      "@type": "schema:Visualization",
      "title": "3D Force Graph Visualization",
      "description": "3D force-directed graph visualization of Spirit Type and Ghost Pattern classifications using WebGPU",
      "usesTechnology": "WebGPU (Force3DWordGraphTypeGPU)",
      "visualizes": [
        "https://spirit-in-physics.gftd.ai/research/data-types/spirit-types",
        "https://spirit-in-physics.gftd.ai/research/data-types/ghost-patterns"
      ],
      "hasParameter": {
        "springK": 2.0,
        "repulsionK": 2000.0,
        "damping": 0.92,
        "restLength": 80,
        "shellRadius": 300,
        "shellK": 1.5,
        "radialOutK": 120
      }
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/research/visualizations/complex-space-3d",
      "@type": "schema:Visualization",
      "title": "Complex Space 3D Visualization",
      "description": "3D visualization of 1024-dimensional Complex space projected to 3D using PCA or UMAP",
      "usesTechnology": "PCA / UMAP + WebGPU",
      "visualizes": [
        "https://spirit-in-physics.gftd.ai/research/data-types/complex-space"
      ],
      "hasParameter": {
        "projectionMethod": "pca",
        "pcaComponents": 3,
        "umapNeighbors": 15,
        "umapMinDist": 0.1,
        "outputBounds": "[-200, 200]"
      }
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/research/visualizations/network-graph",
      "@type": "schema:Visualization",
      "title": "Word Network Graph",
      "description": "Network graph visualization of word associations with nodes colored by classification type",
      "usesTechnology": "D3.js / vis.js",
      "visualizes": [
        "https://spirit-in-physics.gftd.ai/research/data-types/word-pairs",
        "https://spirit-in-physics.gftd.ai/research/data-types/word-associations"
      ],
      "hasParameter": {
        "minWeight": 0.1,
        "layout": "force-directed",
        "nodeSize": "based on frequency",
        "edgeThickness": "based on P(w_O | w_I)"
      }
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/research/visualizations/clustering",
      "@type": "schema:Visualization",
      "title": "Word Clustering Visualization",
      "description": "Clustering visualization grouped by archetype (Spirit Types) and shadow type (Ghost Patterns)",
      "usesTechnology": "Custom clustering visualization",
      "visualizes": [
        "https://spirit-in-physics.gftd.ai/research/data-types/spirit-types",
        "https://spirit-in-physics.gftd.ai/research/data-types/ghost-patterns"
      ],
      "hasParameter": {
        "clusteringMethod": "hierarchical",
        "distanceMetric": "euclidean",
        "linkage": "ward"
      }
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/research/visualizations/word-list",
      "@type": "schema:Visualization",
      "title": "Interactive Word List",
      "description": "Interactive word list with filtering, sorting, and search capabilities",
      "usesTechnology": "Client-side JavaScript",
      "visualizes": [
        "https://spirit-in-physics.gftd.ai/research/data-types/word-pairs"
      ],
      "hasParameter": {
        "filterBy": ["classificationType", "emotion", "reactionTime"],
        "sortBy": ["frequency", "reactionValue", "reactionTime"],
        "searchEnabled": true
      }
    }
  ]
}

