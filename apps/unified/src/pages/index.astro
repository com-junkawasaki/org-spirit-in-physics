---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Spirit in Physics - Unified Platform">
  <main class="flex min-h-screen flex-col items-center justify-center p-24 bg-gray-50 dark:bg-gray-900">
    <div class="text-center">
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-8">
        <span class="bg-clip-text text-transparent bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500">
          Spirit in Physics
        </span>
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-12">
        Unified Platform
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl">
        <a 
          href="/demo" 
          class="p-6 bg-white dark:bg-gray-800 rounded-lg shadow-lg hover:shadow-xl transition-shadow"
        >
          <h2 class="text-2xl font-bold mb-2">Demo</h2>
          <p class="text-gray-600 dark:text-gray-400">Real-time Complex visualization demo</p>
        </a>
        <a 
          href="/paper" 
          class="p-6 bg-white dark:bg-gray-800 rounded-lg shadow-lg hover:shadow-xl transition-shadow"
        >
          <h2 class="text-2xl font-bold mb-2">Paper</h2>
          <p class="text-gray-600 dark:text-gray-400">Research paper and publications</p>
        </a>
        <a 
          href="/participant" 
          class="p-6 bg-white dark:bg-gray-800 rounded-lg shadow-lg hover:shadow-xl transition-shadow"
        >
          <h2 class="text-2xl font-bold mb-2">Participant</h2>
          <p class="text-gray-600 dark:text-gray-400">Participant interface and experiments</p>
        </a>
        <a 
          href="/researcher" 
          class="p-6 bg-white dark:bg-gray-800 rounded-lg shadow-lg hover:shadow-xl transition-shadow"
        >
          <h2 class="text-2xl font-bold mb-2">Researcher</h2>
          <p class="text-gray-600 dark:text-gray-400">Researcher dashboard and analysis</p>
        </a>
      </div>
    </div>
  </main>
</Layout>

