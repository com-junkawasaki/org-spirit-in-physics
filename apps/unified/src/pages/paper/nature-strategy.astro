---
// Merkle DAG: pages.nature_strategy
// Nature submission strategy page

import ResearchLayout from '../../layouts/ResearchLayout.astro';
import ResearchPaper from '../../components/paper/ResearchPaper.astro';
import TableOfContents from '../../components/paper/TableOfContents.astro';
import { getEntry } from 'astro:content';

const paper = await getEntry('papers', 'nature-submission-strategy');

if (!paper) {
  throw new Error('Paper not found');
}

const { Content } = await paper.render();

const sections = [
  { id: 'abstract', title: 'Abstract (Nature Submission Draft)', level: 1 },
  { id: 'physical-definition', title: 'Revised Physical Definition of Spirit', level: 1 },
  { id: 'complex-space-definition', title: 'Complex Space Definition', level: 2 },
  { id: 'information-energy', title: 'Information Energy', level: 2 },
  { id: 'entropy-production', title: 'Local Velocity and Entropy Production', level: 2 },
  { id: 'spirit-scalar', title: 'Spirit Scalar Quantity', level: 2 },
  { id: 'spirit-vector', title: 'Spirit Vector Field Representation', level: 2 },
  { id: 'execution-steps', title: 'Strategy A Execution Steps', level: 1 },
  { id: 'phase-0', title: 'Phase 0: Theory Redefinition', level: 2 },
  { id: 'phase-1', title: 'Phase 1: Online Experiment Platform Setup', level: 2 },
  { id: 'phase-2', title: 'Phase 2: Data Collection', level: 2 },
  { id: 'phase-3', title: 'Phase 3: Analysis Pipeline', level: 2 },
  { id: 'phase-4', title: 'Phase 4: Writing and Submission', level: 2 },
  { id: 'dataset-requirements', title: 'Required Dataset Size', level: 1 },
  { id: 'sample-size', title: 'Sample Size Order of Magnitude', level: 2 },
  { id: 'recommended-plan', title: 'Recommended Plan', level: 2 },
  { id: 'summary', title: 'Summary', level: 1 },
];

---

<ResearchLayout
  title={paper.data.title}
  description={paper.data.description}
  authors={paper.data.authors}
  date={paper.data.date}
>
  <div class="flex flex-col lg:flex-row">
    <div class="flex-1">
      <ResearchPaper
        title={paper.data.title}
        description={paper.data.description}
        authors={paper.data.authors}
        date={paper.data.date}
        affiliations={paper.data.affiliations}
        schemaId={paper.data.schemaId}
      >
        <Content />
      </ResearchPaper>
    </div>
    <TableOfContents sections={sections} />
  </div>
</ResearchLayout>

