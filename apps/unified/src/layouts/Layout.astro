---
import '../styles/globals.css';
import ClientClerkProvider from '../components/participant/ClientClerkProvider';
import { extractLocaleFromRequest } from '../paraglide/runtime.js';

interface Props {
  title?: string;
  description?: string;
  requireClerk?: boolean;
}

const { 
  title = "Spirit in Physics",
  description = "Extended evaluation of human illusion by Jungian psychology and computational models.",
  requireClerk = false,
} = Astro.props;

// Extract locale from request (cookie-based)
let locale = 'ja';
try {
  locale = extractLocaleFromRequest(Astro.request);
} catch {
  // Fallback to default locale if extraction fails
  locale = 'ja';
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    {requireClerk ? (
      <ClientClerkProvider client:load>
        <slot />
      </ClientClerkProvider>
    ) : (
      <slot />
    )}
  </body>
</html>

