{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "module": "ESNext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@spirit-in-physics/jung-voice-assessment": [
        "../../packages/jung-voice-assessment/dist/index.d.ts",
        "../../packages/jung-voice-assessment/src/index.ts"
      ],
      "@spirit-in-physics/jung-voice-assessment/*": [
        "../../packages/jung-voice-assessment/src/*"
      ],
      "@spirit-in-physics/visualization-components": [
        "../../packages/visualization-components/dist/index.d.ts",
        "../../packages/visualization-components/src/index.ts"
      ],
      "@spirit-in-physics/visualization-components/*": [
        "../../packages/visualization-components/src/*"
      ],
      "@spirit-in-physics/grpc-client": [
        "../../packages/grpc-client/dist/index.d.ts",
        "../../packages/grpc-client/src/index.ts"
      ],
      "@spirit-in-physics/grpc-client/*": [
        "../../packages/grpc-client/src/*"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "**/*.ts",
    "**/*.tsx",
    "**/*.astro",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".astro"
  ]
}

