{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "module": "ESNext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@spirit-in-physics/jung-voice-assessment": [
        "../../packages/jung-voice-assessment/dist/index.d.ts",
        "../../packages/jung-voice-assessment/src/index.ts"
      ],
      "@spirit-in-physics/jung-voice-assessment/*": [
        "../../packages/jung-voice-assessment/src/*"
      ],
      "@spirit-in-physics/visualization-components": [
        "../../packages/visualization-components/dist/index.d.ts",
        "../../packages/visualization-components/src/index.ts"
      ],
      "@spirit-in-physics/visualization-components/*": [
        "../../packages/visualization-components/src/*"
      ],
      "@spirit-in-physics/grpc-client": [
        "../../packages/grpc-client/dist/index.d.ts",
        "../../packages/grpc-client/src/index.ts"
      ],
      "@spirit-in-physics/grpc-client/*": [
        "../../packages/grpc-client/src/*"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mdx",
    ".next/types/**/*.ts",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "../../packages/jung-voice-assessment/src",
    "src/content/**/*.ts"
  ]
}
