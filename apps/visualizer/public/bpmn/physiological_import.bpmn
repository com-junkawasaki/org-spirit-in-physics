<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="8.7.1">
  <bpmn:process id="PhysiologicalImportProcess" name="生理データインポートプロセス" isExecutable="true">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="生理データインポート開始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Participant Validation -->
    <bpmn:serviceTask id="Task_ValidateParticipant" name="参加者存在確認" implementation="participant-validation">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- Gateway for Participant Check -->
    <bpmn:exclusiveGateway id="Gateway_ParticipantCheck" name="参加者存在チェック">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Participant Not Found -->
    <bpmn:endEvent id="EndEvent_ParticipantNotFound" name="参加者未発見">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- Scan Physiological Files -->
    <bpmn:serviceTask id="Task_ScanPhysiologicalFiles" name="生理データファイルスキャン" implementation="file-scanner">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- Gateway for File Check -->
    <bpmn:exclusiveGateway id="Gateway_FileCheck" name="ファイル存在チェック">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- No Files Found -->
    <bpmn:endEvent id="EndEvent_NoFiles" name="ファイル未発見">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- Parse CSV Data -->
    <bpmn:serviceTask id="Task_ParseCSVData" name="CSVデータ解析" implementation="csv-parser">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- Validate Data -->
    <bpmn:serviceTask id="Task_ValidateData" name="データ検証" implementation="data-validator">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- Gateway for Data Validation -->
    <bpmn:exclusiveGateway id="Gateway_DataValidation" name="データ検証チェック">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Data Validation Failed -->
    <bpmn:endEvent id="EndEvent_ValidationFailed" name="データ検証失敗">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- Bulk Insert to Neo4j -->
    <bpmn:serviceTask id="Task_BulkInsert" name="Neo4jバルク挿入" implementation="neo4j-bulk-insert">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- Create Relationships -->
    <bpmn:serviceTask id="Task_CreateRelationships" name="関係作成" implementation="relationship-creator">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- Update Statistics -->
    <bpmn:serviceTask id="Task_UpdateStatistics" name="統計更新" implementation="statistics-updater">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- Success End Event -->
    <bpmn:endEvent id="EndEvent_Success" name="インポート完了">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_ValidateParticipant" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ValidateParticipant" targetRef="Gateway_ParticipantCheck" />
    <bpmn:sequenceFlow id="Flow_3" name="参加者未発見" sourceRef="Gateway_ParticipantCheck" targetRef="EndEvent_ParticipantNotFound" />
    <bpmn:sequenceFlow id="Flow_4" name="参加者存在" sourceRef="Gateway_ParticipantCheck" targetRef="Task_ScanPhysiologicalFiles" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ScanPhysiologicalFiles" targetRef="Gateway_FileCheck" />
    <bpmn:sequenceFlow id="Flow_6" name="ファイル未発見" sourceRef="Gateway_FileCheck" targetRef="EndEvent_NoFiles" />
    <bpmn:sequenceFlow id="Flow_7" name="ファイル存在" sourceRef="Gateway_FileCheck" targetRef="Task_ParseCSVData" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ParseCSVData" targetRef="Task_ValidateData" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ValidateData" targetRef="Gateway_DataValidation" />
    <bpmn:sequenceFlow id="Flow_10" name="検証失敗" sourceRef="Gateway_DataValidation" targetRef="EndEvent_ValidationFailed" />
    <bpmn:sequenceFlow id="Flow_11" name="検証成功" sourceRef="Gateway_DataValidation" targetRef="Task_BulkInsert" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_BulkInsert" targetRef="Task_CreateRelationships" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_CreateRelationships" targetRef="Task_UpdateStatistics" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_UpdateStatistics" targetRef="EndEvent_Success" />
  </bpmn:process>
  
  <!-- BPMN Diagram -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="PhysiologicalImportProcess">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="179" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="158" y="142" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ValidateParticipant_di" bpmnElement="Task_ValidateParticipant">
        <dc:Bounds x="270" y="77" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ParticipantCheck_di" bpmnElement="Gateway_ParticipantCheck" isMarkerVisible="true">
        <dc:Bounds x="425" y="92" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="405" y="149" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ParticipantNotFound_di" bpmnElement="EndEvent_ParticipantNotFound">
        <dc:Bounds x="527" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="506" y="142" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ScanPhysiologicalFiles_di" bpmnElement="Task_ScanPhysiologicalFiles">
        <dc:Bounds x="270" y="200" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_FileCheck_di" bpmnElement="Gateway_FileCheck" isMarkerVisible="true">
        <dc:Bounds x="425" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="405" y="272" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_NoFiles_di" bpmnElement="EndEvent_NoFiles">
        <dc:Bounds x="527" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="506" y="265" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ParseCSVData_di" bpmnElement="Task_ParseCSVData">
        <dc:Bounds x="270" y="323" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ValidateData_di" bpmnElement="Task_ValidateData">
        <dc:Bounds x="270" y="446" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DataValidation_di" bpmnElement="Gateway_DataValidation" isMarkerVisible="true">
        <dc:Bounds x="425" y="461" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="405" y="518" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ValidationFailed_di" bpmnElement="EndEvent_ValidationFailed">
        <dc:Bounds x="527" y="468" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="506" y="511" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_BulkInsert_di" bpmnElement="Task_BulkInsert">
        <dc:Bounds x="270" y="569" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_CreateRelationships_di" bpmnElement="Task_CreateRelationships">
        <dc:Bounds x="270" y="692" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_UpdateStatistics_di" bpmnElement="Task_UpdateStatistics">
        <dc:Bounds x="270" y="815" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Success_di" bpmnElement="EndEvent_Success">
        <dc:Bounds x="527" y="842" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="506" y="885" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Sequence Flow Edges -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="215" y="117" />
        <di:waypoint x="270" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="370" y="117" />
        <di:waypoint x="425" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="475" y="117" />
        <di:waypoint x="527" y="117" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="480" y="99" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="450" y="142" />
        <di:waypoint x="450" y="200" />
        <di:waypoint x="370" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="460" y="161" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="370" y="240" />
        <di:waypoint x="425" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="475" y="240" />
        <di:waypoint x="527" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="480" y="222" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="450" y="265" />
        <di:waypoint x="450" y="323" />
        <di:waypoint x="370" y="363" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="460" y="284" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="370" y="403" />
        <di:waypoint x="320" y="403" />
        <di:waypoint x="320" y="446" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="370" y="486" />
        <di:waypoint x="425" y="486" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="475" y="486" />
        <di:waypoint x="527" y="486" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="480" y="468" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="450" y="511" />
        <di:waypoint x="450" y="569" />
        <di:waypoint x="370" y="609" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="460" y="530" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="370" y="649" />
        <di:waypoint x="320" y="649" />
        <di:waypoint x="320" y="692" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="370" y="732" />
        <di:waypoint x="320" y="732" />
        <di:waypoint x="320" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="370" y="855" />
        <di:waypoint x="527" y="860" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
