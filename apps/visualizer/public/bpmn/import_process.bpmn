<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ImportPipeline_UI" targetNamespace="http://example.com/bpmn">
  <process id="ImportPipelineUI" isExecutable="true">
    <startEvent id="Start" name="Start"/>
    <sequenceFlow id="f1" sourceRef="Start" targetRef="ImportParticipants"/>
    <task id="ImportParticipants" name="Import Participants"/>
    <sequenceFlow id="f2" sourceRef="ImportParticipants" targetRef="ImportSessions"/>
    <task id="ImportSessions" name="Import Sessions"/>
    <sequenceFlow id="f3" sourceRef="ImportSessions" targetRef="ImportEmotions"/>
    <task id="ImportEmotions" name="Import Emotions"/>
    <sequenceFlow id="f4" sourceRef="ImportEmotions" targetRef="CheckStatus"/>
    <task id="CheckStatus" name="Check Status"/>
    <sequenceFlow id="f5" sourceRef="CheckStatus" targetRef="End"/>
    <endEvent id="End" name="End"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ImportPipeline">
    <bpmndi:BPMNPlane id="BPMNPlane_ImportPipeline" bpmnElement="ImportPipelineUI">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <omgdc:Bounds x="152" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ImportParticipants_di" bpmnElement="ImportParticipants">
        <omgdc:Bounds x="240" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ImportSessions_di" bpmnElement="ImportSessions">
        <omgdc:Bounds x="400" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ImportEmotions_di" bpmnElement="ImportEmotions">
        <omgdc:Bounds x="560" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckStatus_di" bpmnElement="CheckStatus">
        <omgdc:Bounds x="720" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <omgdc:Bounds x="872" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <omgdi:waypoint x="188" y="120"/>
        <omgdi:waypoint x="240" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <omgdi:waypoint x="340" y="120"/>
        <omgdi:waypoint x="400" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <omgdi:waypoint x="500" y="120"/>
        <omgdi:waypoint x="560" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <omgdi:waypoint x="660" y="120"/>
        <omgdi:waypoint x="720" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <omgdi:waypoint x="820" y="120"/>
        <omgdi:waypoint x="872" y="120"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>


