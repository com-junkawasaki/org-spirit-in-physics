  <bpmn:process id="EmotionImportProcess" name="感情データインポートプロセス" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="感情データインポート開始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_1" name="参加者存在確認">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_1" name="参加者存在？">
