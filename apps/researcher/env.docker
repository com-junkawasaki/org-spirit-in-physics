# GraphQL API Configuration
# Server-side: Use Docker service name for internal communication within Docker network
GRAPHQL_API_URL=http://graphql-service:8081/graphql
# Client-side: Use localhost for browser access (OrbStack maps ports)
NEXT_PUBLIC_GRAPHQL_API_URL=http://localhost:8081/graphql

# API URL
NEXT_PUBLIC_API_URL=http://visualizer:3000

# Inngest Configuration
NODE_ENV=development
INNGEST_EVENT_KEY=local_dev_key
INNGEST_SIGNING_KEY=local_dev_signing_key

