{
  "name": "@spirit-in-physics/researcher",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./constants/*": {
      "types": "./src/constants/*.ts",
      "default": "./src/constants/*.ts"
    }
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "prebuild": "pnpm codegen",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "codegen": "graphql-codegen --config codegen.yaml",
    "codegen:watch": "graphql-codegen --config codegen.yaml --watch"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@react-spring/three": "^10.0.3",
    "@spirit-in-physics/visualization-components": "file:./packages/visualization-components",
    "@types/three": "^0.180.0",
    "@xyflow/react": "^12.8.6",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "graphql": "^16.12.0",
    "graphql-request": "^6.1.0",
    "inngest": "^3.44.3",
    "lucide-react": "^0.528.0",
    "next": "14.2.25",
    "plotly.js": "^2.35.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typegpu": "^0.7.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/client-preset": "^4.2.5",
    "@graphql-codegen/typescript": "^4.0.1",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "@graphql-codegen/typescript-operations": "^4.2.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/d3": "^7.4.3",
    "@types/node": "20.11.20",
    "@types/plotly.js": "^2.35.2",
    "@types/react": "18.2.57",
    "@types/three": "^0.180.0",
    "typescript": "5.3.3"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  }
}
