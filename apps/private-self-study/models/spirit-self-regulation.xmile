<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0">
  <header>
    <vendor>com-junkawasaki/org-spirit-in-physics</vendor>
    <product version="0.1.0">private-self-study</product>
    <name>Spirit self-regulation exploratory model</name>
  </header>
  <sim_specs method="euler" time_units="second">
    <start>0</start><stop>180</stop><dt>1</dt>
  </sim_specs>
  <model name="spirit-self-regulation">
    <variables>
      <stock name="Regulatory_Capacity"><eqn>0.5</eqn><inflow>integration_gain</inflow><outflow>overload_loss</outflow></stock>
      <stock name="Arousal_Load"><eqn>0.5</eqn><inflow>arousal_gain</inflow><outflow>arousal_recovery</outflow></stock>
      <stock name="Meaning_Coherence"><eqn>0.5</eqn><inflow>coherence_gain</inflow><outflow>coherence_decay</outflow></stock>
      <stock name="Perceived_Agency"><eqn>0.5</eqn><inflow>agency_gain</inflow><outflow>agency_loss</outflow></stock>
      <aux name="condition_adaptive"><eqn>0</eqn></aux>
      <aux name="state_match"><eqn>0.7</eqn></aux>
      <aux name="sensory_intensity"><eqn>0.35</eqn></aux>
      <aux name="participant_tolerance"><eqn>0.65</eqn></aux>
      <aux name="alignment"><eqn>condition_adaptive * state_match + (1 - condition_adaptive) * 0.5</eqn></aux>
      <aux name="overload"><eqn>MAX(0, sensory_intensity - participant_tolerance)</eqn></aux>
      <flow name="integration_gain"><eqn>alignment * (1 - Regulatory_Capacity) * 0.08</eqn></flow>
      <flow name="overload_loss"><eqn>overload * Regulatory_Capacity * 0.12</eqn></flow>
      <flow name="arousal_gain"><eqn>sensory_intensity * (1 - Arousal_Load) * 0.10</eqn></flow>
      <flow name="arousal_recovery"><eqn>(1 - sensory_intensity) * Arousal_Load * 0.08</eqn></flow>
      <flow name="coherence_gain"><eqn>alignment * Regulatory_Capacity * (1 - Meaning_Coherence) * 0.06</eqn></flow>
      <flow name="coherence_decay"><eqn>(1 - alignment) * Meaning_Coherence * 0.04</eqn></flow>
      <flow name="agency_gain"><eqn>alignment * (1 - Perceived_Agency) * 0.04</eqn></flow>
      <flow name="agency_loss"><eqn>overload * Perceived_Agency * 0.10</eqn></flow>
    </variables>
  </model>
</xmile>
