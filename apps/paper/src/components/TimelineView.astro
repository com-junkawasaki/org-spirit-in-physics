---
// Merkle DAG: components.timeline_view
// Timeline view component for research app

import type { ExperimentalData } from '../types/experimental';
import { TimelineVisualization } from '@spirit-in-physics/visualization-components';

interface Props {
  data: ExperimentalData;
  width?: number;
  height?: number;
}

const { data, width = 1000, height = 400 } = Astro.props;

// Get participantId and sessionId from data
const participantId = data.participants.length > 0 ? data.participants[0].id : '';
const sessionId = data.sessions.length > 0 ? data.sessions[0].id : undefined;
---

<div class="timeline-view">
  <TimelineVisualization
    client:only="react"
    participantId={participantId}
    sessionId={sessionId}
    width={width}
    height={height}
    hideFilters={true}
  />
</div>

<style>
  .timeline-view {
    width: 100%;
  }
</style>

