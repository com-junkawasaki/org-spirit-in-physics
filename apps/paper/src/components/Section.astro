---
// Merkle DAG: components.section
// Section wrapper component with JSON-LD annotations

interface Props {
  id: string;
  title: string;
  description?: string;
  schemaId?: string;
}

const { id, title, description, schemaId } = Astro.props;
---

<section id={id} class="mb-12 scroll-mt-20">
  <h2 class="text-3xl font-bold mb-4">{title}</h2>
  {description && <p class="text-lg text-gray-600 dark:text-gray-400 mb-6">{description}</p>}
  <slot />
</section>

