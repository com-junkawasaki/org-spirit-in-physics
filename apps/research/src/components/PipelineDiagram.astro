---
// Merkle DAG: components.pipeline_diagram
// Pipeline diagram component showing data processing steps

interface PipelineStep {
  id: string;
  name: string;
  description: string;
  inputs: string[];
  outputs: string[];
  algorithm?: string;
  parameters?: Record<string, string | number>;
}

const pipelineSteps: PipelineStep[] = [
  {
    id: 'data-collection',
    name: 'Data Collection',
    description: 'Collect experimental data from TimelineVisualization',
    inputs: ['Word display events', 'Response events', 'Physiological data', 'Emotion data'],
    outputs: ['Timeline data', 'Word pairs', 'Reaction times', 'Emotion scores'],
  },
  {
    id: 'data-aggregation',
    name: 'Data Aggregation',
    description: 'Aggregate data using TimescaleDB materialized views',
    inputs: ['Timeline data'],
    outputs: ['Word aggregates', 'Emotion vectors', 'Word statistics'],
    algorithm: 'TimescaleDB Materialized View',
  },
  {
    id: 'component-extraction',
    name: 'Component Extraction',
    description: 'Extract Gene, Meme, and Field components',
    inputs: ['Word aggregates', 'Emotion vectors', 'Reaction times', 'Skin potential'],
    outputs: ['Gene component', 'Meme component', 'Field component'],
    algorithm: 'Normalization + Cosine Similarity',
    parameters: {
      'Gene normalization': 'z-score',
      'Meme combination': '(word2vec + emotion) / 2',
      'Field combination': '(skinPotential + temporalPosition) / 2',
    },
  },
  {
    id: 'dimensionality-reduction',
    name: 'Dimensionality Reduction',
    description: 'Project 1024d Complex space to 3D',
    inputs: ['1024d vectors'],
    outputs: ['3D coordinates'],
    algorithm: 'PCA or UMAP',
    parameters: {
      'PCA components': 3,
      'UMAP neighbors': 15,
      'UMAP minDist': 0.1,
      'Output bounds': '[-200, 200]',
    },
  },
  {
    id: 'classification',
    name: 'Classification',
    description: 'Classify Spirit Type vs Ghost Pattern',
    inputs: ['Gene/Meme/Field components', '3D coordinates'],
    outputs: ['Spirit Types', 'Ghost Patterns'],
    algorithm: 'K-means / DBSCAN / Isolation Forest',
    parameters: {
      'Distance threshold': 1.0,
      'K-means clusters': 'auto',
      'DBSCAN eps': 0.5,
    },
  },
  {
    id: 'visualization',
    name: 'Visualization',
    description: 'Generate 3D models, network graphs, and word lists',
    inputs: ['Spirit Types', 'Ghost Patterns', '3D coordinates'],
    outputs: ['3D Force Graph', 'Network Graph', 'Clustering', 'Word List'],
    algorithm: 'WebGPU / D3.js / Custom',
    parameters: {
      '3D physics': 'Force-directed layout',
      'Network layout': 'Force-directed',
      'Clustering method': 'Hierarchical',
    },
  },
];
---

<div class="pipeline-diagram">
  <h3 class="text-lg font-semibold mb-4">Data Processing and Visualization Pipeline</h3>
  
  <div class="space-y-6">
    {pipelineSteps.map((step, index) => (
      <div key={step.id} class="border rounded-lg p-4 bg-white">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-500 text-white flex items-center justify-center font-semibold">
            {index + 1}
          </div>
          <div class="flex-1">
            <h4 class="font-semibold text-base mb-1">{step.name}</h4>
            <p class="text-sm text-gray-600 mb-3">{step.description}</p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
              <div>
                <h5 class="font-medium mb-1 text-gray-700">Inputs:</h5>
                <ul class="list-disc list-inside text-gray-600 space-y-1">
                  {step.inputs.map(input => (
                    <li key={input}>{input}</li>
                  ))}
                </ul>
              </div>
              
              <div>
                <h5 class="font-medium mb-1 text-gray-700">Outputs:</h5>
                <ul class="list-disc list-inside text-gray-600 space-y-1">
                  {step.outputs.map(output => (
                    <li key={output}>{output}</li>
                  ))}
                </ul>
              </div>
            </div>
            
            {step.algorithm && (
              <div class="mt-3 text-sm">
                <span class="font-medium text-gray-700">Algorithm: </span>
                <span class="text-gray-600">{step.algorithm}</span>
              </div>
            )}
            
            {step.parameters && (
              <div class="mt-3 text-sm">
                <h5 class="font-medium mb-1 text-gray-700">Parameters:</h5>
                <ul class="list-disc list-inside text-gray-600 space-y-1">
                  {Object.entries(step.parameters).map(([key, value]) => (
                    <li key={key}>
                      <strong>{key}:</strong> {String(value)}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
        
        {index < pipelineSteps.length - 1 && (
          <div class="flex justify-center mt-4">
            <div class="w-0.5 h-6 bg-gray-300"></div>
          </div>
        )}
      </div>
    ))}
  </div>
  
  <div class="mt-6 p-4 bg-gray-50 rounded-lg text-sm">
    <h4 class="font-semibold mb-2">Data Flow:</h4>
    <p class="text-gray-600">
      TimelineVisualization → GraphQL API → Component Extraction → Classification → 
      Dimensionality Reduction → Visualization (3D Models, Network Graphs, Word Lists)
    </p>
  </div>
</div>

<style>
  .pipeline-diagram {
    width: 100%;
  }
</style>

