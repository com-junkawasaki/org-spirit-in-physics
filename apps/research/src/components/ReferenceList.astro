---
// Merkle DAG: components.reference_list
// Bibliography component with citation graph

interface Props {
  references: Array<{
    id: string;
    citation: string;
    doi?: string;
    url?: string;
  }>;
}

const { references } = Astro.props;
---

<section id="references" class="mt-12">
  <h2 class="text-3xl font-bold mb-6">References</h2>
  <ol class="list-decimal list-inside space-y-3 prose prose-lg dark:prose-invert">
    {references.map((ref) => (
      <li id={ref.id} class="mb-4">
        <span>{ref.citation}</span>
        {ref.doi && (
          <a href={`https://doi.org/${ref.doi}`} class="ml-2 text-blue-600 dark:text-blue-400" target="_blank" rel="noopener noreferrer">
            DOI: {ref.doi}
          </a>
        )}
        {ref.url && (
          <a href={ref.url} class="ml-2 text-blue-600 dark:text-blue-400" target="_blank" rel="noopener noreferrer">
            Link
          </a>
        )}
      </li>
    ))}
  </ol>
</section>

