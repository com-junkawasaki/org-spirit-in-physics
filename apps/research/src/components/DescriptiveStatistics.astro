---
// Merkle DAG: components.DescriptiveStatistics
// Descriptive statistics tables for participants and classification results

import type { ExperimentalData } from '../types/experimental';

interface Props {
  data: ExperimentalData;
}

const { data } = Astro.props;
const { participants, classification } = data;

const totalParticipants = participants.length;
const totalResponses = data.responses.length;
const spiritTypeCount = classification.spiritTypeCount;
const ghostPatternCount = classification.ghostPatternCount;
const spiritTypePercentage = totalResponses > 0
  ? ((spiritTypeCount / totalResponses) * 100).toFixed(1)
  : '0.0';
const ghostPatternPercentage = totalResponses > 0
  ? ((ghostPatternCount / totalResponses) * 100).toFixed(1)
  : '0.0';
---

<div class="my-8">
  <h3>Table 1: Participant Characteristics</h3>
  <div class="overflow-x-auto">
    <table class="min-w-full border-collapse border border-gray-300 dark:border-gray-700">
      <thead>
        <tr class="bg-gray-100 dark:bg-gray-800">
          <th class="border border-gray-300 dark:border-gray-700 px-4 py-2 text-left">Characteristic</th>
          <th class="border border-gray-300 dark:border-gray-700 px-4 py-2 text-left">Value</th>
        </tr>
      </thead>
      <tbody>
        <tr class="dark:bg-gray-900/50">
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">Total Participants</td>
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">{totalParticipants}</td>
        </tr>
        <tr class="dark:bg-gray-900/50">
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">Total Responses</td>
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">{totalResponses}</td>
        </tr>
        <tr class="dark:bg-gray-900/50">
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">Mean Age (years)</td>
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">
            {participants.length > 0 && participants[0].age
              ? participants.reduce((sum, p) => sum + (p.age || 0), 0) / participants.length
              : 'N/A'}
          </td>
        </tr>
        <tr class="dark:bg-gray-900/50">
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">Gender Distribution</td>
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">
            {participants.filter(p => p.gender === 'male').length} Male,{' '}
            {participants.filter(p => p.gender === 'female').length} Female
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<div class="my-8">
  <h3>Table 2: Spirit Type and Ghost Pattern Classification Results</h3>
  <div class="overflow-x-auto">
    <table class="min-w-full border-collapse border border-gray-300 dark:border-gray-700">
      <thead>
        <tr class="bg-gray-100 dark:bg-gray-800">
          <th class="border border-gray-300 dark:border-gray-700 px-4 py-2 text-left">Classification</th>
          <th class="border border-gray-300 dark:border-gray-700 px-4 py-2 text-left">Count</th>
          <th class="border border-gray-300 dark:border-gray-700 px-4 py-2 text-left">Percentage (%)</th>
        </tr>
      </thead>
      <tbody>
        <tr class="dark:bg-gray-900/50">
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">Spirit Type</td>
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">{spiritTypeCount}</td>
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">{spiritTypePercentage}</td>
        </tr>
        <tr class="dark:bg-gray-900/50">
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">Ghost Pattern</td>
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">{ghostPatternCount}</td>
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2">{ghostPatternPercentage}</td>
        </tr>
        <tr class="dark:bg-gray-900/50">
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2 font-semibold">Total</td>
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2 font-semibold">{totalResponses}</td>
          <td class="border border-gray-300 dark:border-gray-700 px-4 py-2 font-semibold">100.0</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

