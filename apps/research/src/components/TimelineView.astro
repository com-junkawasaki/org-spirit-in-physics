---
// Merkle DAG: components.timeline_view
// Timeline view component for research app

import type { ExperimentalData } from '../types/experimental';
import TimelineVisualization from './react/TimelineVisualization';

interface Props {
  data: ExperimentalData;
  width?: number;
  height?: number;
}

const { data, width = 1000, height = 400 } = Astro.props;

// Convert responses to timeline data points
const timelineData = data.responses.map(response => ({
  time: response.createdAt,
  word: response.stimulusWord,
  reactionTime: response.reactionTimeMs,
  reactionValue: response.wordAssociationProbability,
  emotion: response.emotionData,
  physiological: Array.isArray(response.physiologicalData) ? response.physiologicalData : undefined,
}));
---

<div class="timeline-view">
  <TimelineVisualization
    client:load
    data={timelineData}
    width={width}
    height={height}
  />
</div>

<style>
  .timeline-view {
    width: 100%;
  }
</style>

