{
  "@context": {
    "@base": "terminusdb:///data/",
    "@schema": "terminusdb:///schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "tcs": "https://terminusdb.com/schema/tcs#"
  },
  "@type": "owl:Ontology",
  "rdfs:comment": {
    "@language": "en",
    "@value": "Schema for Spirit in Physics experiment data - TerminusDB RDF model"
  },
  "@graph": [
    {
      "@id": "Participant",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "Participant"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A participant in the Spirit in Physics experiment"
      }
    },
    {
      "@id": "Consent",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "Consent"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Participant consent information"
      }
    },
    {
      "@id": "ExperimentSession",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "Experiment Session"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "An experiment session conducted with a participant"
      }
    },
    {
      "@id": "WordStimulus",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "Word Stimulus"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A stimulus word used in the experiment"
      }
    },
    {
      "@id": "ResponseData",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "Response Data"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Participant response data from the experiment"
      }
    },
    {
      "@id": "id",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": ["Participant", "Consent", "ExperimentSession", "WordStimulus", "ResponseData"],
      "rdfs:range": "xsd:string",
      "rdfs:label": {
        "@language": "en",
        "@value": "ID"
      }
    },
    {
      "@id": "age",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "Participant",
      "rdfs:range": "xsd:integer",
      "rdfs:label": {
        "@language": "en",
        "@value": "Age"
      }
    },
    {
      "@id": "gender",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "Participant",
      "rdfs:range": "xsd:string",
      "rdfs:label": {
        "@language": "en",
        "@value": "Gender"
      }
    },
    {
      "@id": "handedness",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "Participant",
      "rdfs:range": "xsd:string",
      "rdfs:label": {
        "@language": "en",
        "@value": "Handedness"
      }
    },
    {
      "@id": "signature",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "Consent",
      "rdfs:range": "xsd:string",
      "rdfs:label": {
        "@language": "en",
        "@value": "Signature"
      }
    },
    {
      "@id": "agreements",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "Consent",
      "rdfs:range": "xsd:string",
      "rdfs:label": {
        "@language": "en",
        "@value": "Agreements"
      }
    },
    {
      "@id": "agreed_at",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "Consent",
      "rdfs:range": "xsd:dateTime",
      "rdfs:label": {
        "@language": "en",
        "@value": "Agreed At"
      }
    },
    {
      "@id": "session_type",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "ExperimentSession",
      "rdfs:range": "xsd:string",
      "rdfs:label": {
        "@language": "en",
        "@value": "Session Type"
      }
    },
    {
      "@id": "start_time",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "ExperimentSession",
      "rdfs:range": "xsd:dateTime",
      "rdfs:label": {
        "@language": "en",
        "@value": "Start Time"
      }
    },
    {
      "@id": "end_time",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "ExperimentSession",
      "rdfs:range": "xsd:dateTime",
      "rdfs:label": {
        "@language": "en",
        "@value": "End Time"
      }
    },
    {
      "@id": "word",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "WordStimulus",
      "rdfs:range": "xsd:string",
      "rdfs:label": {
        "@language": "en",
        "@value": "Word"
      }
    },
    {
      "@id": "stimulus_word",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "ResponseData",
      "rdfs:range": "xsd:string",
      "rdfs:label": {
        "@language": "en",
        "@value": "Stimulus Word"
      }
    },
    {
      "@id": "response_word",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "ResponseData",
      "rdfs:range": "xsd:string",
      "rdfs:label": {
        "@language": "en",
        "@value": "Response Word"
      }
    },
    {
      "@id": "reaction_time_ms",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "ResponseData",
      "rdfs:range": "xsd:integer",
      "rdfs:label": {
        "@language": "en",
        "@value": "Reaction Time (ms)"
      }
    },
    {
      "@id": "timestamp",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "ResponseData",
      "rdfs:range": "xsd:dateTime",
      "rdfs:label": {
        "@language": "en",
        "@value": "Timestamp"
      }
    },
    {
      "@id": "audio_file_path",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "ResponseData",
      "rdfs:range": "xsd:string",
      "rdfs:label": {
        "@language": "en",
        "@value": "Audio File Path"
      }
    },
    {
      "@id": "video_file_path",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "ResponseData",
      "rdfs:range": "xsd:string",
      "rdfs:label": {
        "@language": "en",
        "@value": "Video File Path"
      }
    },
    {
      "@id": "skin_potential",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "ResponseData",
      "rdfs:range": "xsd:decimal",
      "rdfs:label": {
        "@language": "en",
        "@value": "Skin Potential"
      }
    },
    {
      "@id": "emotion",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "ResponseData",
      "rdfs:range": "xsd:string",
      "rdfs:label": {
        "@language": "en",
        "@value": "Emotion"
      }
    },
    {
      "@id": "emotion_confidence",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": "ResponseData",
      "rdfs:range": "xsd:decimal",
      "rdfs:label": {
        "@language": "en",
        "@value": "Emotion Confidence"
      }
    },
    {
      "@id": "created_at",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": ["Participant", "Consent", "ExperimentSession", "WordStimulus", "ResponseData"],
      "rdfs:range": "xsd:dateTime",
      "rdfs:label": {
        "@language": "en",
        "@value": "Created At"
      }
    },
    {
      "@id": "updated_at",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": ["Participant", "Consent", "ExperimentSession", "WordStimulus", "ResponseData"],
      "rdfs:range": "xsd:dateTime",
      "rdfs:label": {
        "@language": "en",
        "@value": "Updated At"
      }
    },
    {
      "@id": "has_consent",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": "Participant",
      "rdfs:range": "Consent",
      "rdfs:label": {
        "@language": "en",
        "@value": "Has Consent"
      }
    },
    {
      "@id": "has_session",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": "Participant",
      "rdfs:range": "ExperimentSession",
      "rdfs:label": {
        "@language": "en",
        "@value": "Has Session"
      }
    },
    {
      "@id": "has_response",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": "Participant",
      "rdfs:range": "ResponseData",
      "rdfs:label": {
        "@language": "en",
        "@value": "Has Response"
      }
    },
    {
      "@id": "belongs_to_participant",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": ["Consent", "ExperimentSession", "ResponseData"],
      "rdfs:range": "Participant",
      "rdfs:label": {
        "@language": "en",
        "@value": "Belongs To Participant"
      }
    },
    {
      "@id": "uses_stimulus",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": "ResponseData",
      "rdfs:range": "WordStimulus",
      "rdfs:label": {
        "@language": "en",
        "@value": "Uses Stimulus"
      }
    },
    {
      "@id": "belongs_to_session",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": "ResponseData",
      "rdfs:range": "ExperimentSession",
      "rdfs:label": {
        "@language": "en",
        "@value": "Belongs To Session"
      }
    }
  ]
}
