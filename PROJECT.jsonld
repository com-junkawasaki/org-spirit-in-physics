    "importProcedure": {
      "@id": "project:documentation:importProcedure",
      "@type": "project:ImportProcedure",
      "title": "@import/ で @participants/ の実験データを import する手順",
      "description": "このドキュメントでは、`@participants/` ディレクトリの実験データを `@import/` 機能を通じてインポートする手順を定義します。",
      "architecture": {
        "merkleDagStructure": {
          "participants": ["scan_participants", "read_consent", "validate_consent", "check_existing", "create_participant", "update_metadata"],
          "sessions": ["read_session_data", "validate_session", "extract_responses", "calculate_stats", "store_responses"],
          "emotions": ["find_hume_data", "process_predictions", "process_csv_data", "store_emotions"]
        }
      },
      "dataStructure": {
        "participantsDirectory": "dataset/participants/{participantId}/",
        "files": ["consent.json", "session_data.json", "*.CSV", "HumeAI_artifacts_*/", "session-*-video.webm"]
      },
      "apiEndpoints": [
        {
          "endpoint": "POST /api/admin/import/participants",
          "flow": ["dataset/participants/ ディレクトリスキャン", "consent.json 読み取り", "データ構造検証", "重複チェック", "参加者ノード作成", "メタデータ更新"]
        },
        {
          "endpoint": "POST /api/admin/import/sessions",
          "flow": ["参加者存在確認", "session_data.json 読み取り", "イベントデータ検証", "重複セッションデータチェック", "単語応答データ抽出", "セッション統計計算", "イベントデータ格納"]
        },
        {
          "endpoint": "POST /api/admin/import/emotions",
          "flow": ["参加者存在確認", "HumeAI_artifacts_* ディレクトリ検索", "HumeAI_predictions_*.json 読み取り", "感情データ構造検証", "重複感情データチェック", "感情エントリ処理", "CSV データ処理", "感情データ格納"]
        }
      },
      "uiInterface": {
        "importPage": "/admin/import",
        "tabs": ["参加者データ", "セッションデータ", "感情分析データ"],
        "features": ["インポート実行ボタン", "リアルタイム進捗表示", "結果表示（成功/エラー/スキップ）", "詳細なエラーメッセージ"]
      }
    }
  },
  
