  "documentation": {
    "@id": "project:documentation",
    "@type": "project:Documentation",
    "readme": {
      "@id": "project:documentation:readme",
      "@type": "project:Readme",
      "title": "Spirit-in-Physics Visualizer — Emotion-Kernel Tensegrity 3D Model",
      "description": "本プロジェクトの 3D 可視化は、感情に誘導された距離（メトリック／カーネル）で語集合に幾何（距離空間）を与え、その距離を最もよく保存するように低次元へ埋め込み、さらにテンセグリティ物理で自己支持的な立体構造へ収束させるモデルです。",
      "sections": [
        {
          "@id": "project:documentation:readme:section:1",
          "title": "データからグラフへ（Emotion Kernel Graph）",
          "content": "各語に対して 10 次元の感情ベクトル `e_i ∈ R^{10}`（Hume 等の推定値）を作成し、正規化。感情ベクトル間の距離に基づき RBF カーネルで重み行列 `W` を構築。`W_ij = exp(− ||e_i − e_j||^2 / σ_eff^2)`、`σ_eff = median_pairwise_distance × σ_ui`。対角行列とラプラシアンを定義: `D_ii = Σ_j W_ij`, `L = D − W`"
        },
        {
          "@id": "project:documentation:readme:section:2",
          "title": "スペクトラル初期化（Spectral Embedding）",
          "content": "`L` の第 2〜4 固有ベクトルをパワー反復＋逐次直交化で近似抽出（第 1 固有ベクトル＝定数は除外）。得られた 3 軸を初期 3D 座標として割当（スケールは `shellRadius × 0.8`）。ON/OFF と σ は UI から制御可能。"
        },
        {
          "@id": "project:documentation:readme:section:3",
          "title": "アンカー（Emotion Anchors）",
          "content": "感情マップ上のラベルを球殻へ射影した固定ノード（`fixed: true`）として追加。アンカーと語を張力（tension）で接続。重みは対応する感情次元のスコア。正規マッピング例（内部 10 感情キー）: Joy→`joy`, Sadness→`sadness`, Anger→`anger`, Fear→`fear`, Disgust→`disgust`, Calmness→`calm`, Interest/Determination→`focus`, Surprise→`surprise`, Confusion→`confusion`。"
        },
        {
          "@id": "project:documentation:readme:section:4",
          "title": "テンセグリティ物理（Unilateral Springs）",
          "content": "各エッジに片側拘束バネを付与: Tension（引張のみ）: `dist > L0` の時だけ `k*(dist−L0)`、Compression（圧縮のみ）: `dist < L0` の時だけ `k*(dist−L0)`。エッジ種別とパラメータ（`mode, L0, k`）は語間の結合強度から決定。強結合ほど `L0` を短く、`k` を大きく（コントラスト強化にロジスティック変換を使用）。次数正規化でハブ吸込みを抑制。"
        },
        {
          "@id": "project:documentation:readme:section:5",
          "title": "ラジアル/殻/トーラスの場（Global Fields）",
          "content": "殻フォース（Shell）: 半径 `shellRadius` へ引寄せ／押出し（`shellK`）。外向きラジアル斥力（`radialOutK`）: 中心からの押し広げで球面化を回避。トーラス吸引（任意、`torusR, torusr, torusK`）: 辺縁系の環状構造を誘導（y 軸周りの輪）。"
        },
        {
          "@id": "project:documentation:readme:section:6",
          "title": "PBD 位置拘束（Stress Minimization Approx.）",
          "content": "PBD 風の長さ拘束投影を `constraintIters` 回適用（強度 `constraintStiffness`）。アンカーは毎フレーム初期位置へ強剛性拘束。"
        },
        {
          "@id": "project:documentation:readme:section:7",
          "title": "レンダリングと形状",
          "content": "ノード形状: 正 12 角柱側面（矩形 12 面）を用い、軸方向に棒状スケーリング。両端に in/out キャップを表示。エッジ: 加重で色／太さに反映。カメラ: 重心追従の look-at（スムージング）。"
        },
        {
          "@id": "project:documentation:readme:section:8",
          "title": "UI パラメータ（主なもの）",
          "content": "Kernel: `σ`（RBF 幅倍率）, `Spectral Init`（ON/OFF）。Physics: `springK`, `repulsionK`, `damping`, `restLength`。Emotion: `Emo Gain`, `Emo Mix`, `γ(w)`（重み強調）。Shell/Fields: `shellRadius`, `shellK`, `radialOutK`。Constraints: `constraintIters`, `constraintStiffness`。Optional: `torusR`, `torusr`, `torusK`（UI 化予定）。"
        },
        {
          "@id": "project:documentation:readme:section:9",
          "title": "データ/API",
          "content": "Timeline API から語イベントを取得し、感情・生理指標を集約。可視化向けダミー（デモ）データも提供可能（`?demo=1`）。GraphQL API 経由で PostgreSQL からデータを取得。"
        },
        {
          "@id": "project:documentation:readme:section:10",
          "title": "実行",
          "content": "`pnpm i`、`pnpm -F apps/researcher dev`。ブラウザで 3D Force Timeline（`/3d-force-timeline`）へアクセス。UI で σ, Spectral Init, Shell/Constraints 等を調整します。"
        },
        {
          "@id": "project:documentation:readme:section:11",
          "title": "設計の要点（Why it works）",
          "content": "スペクトラル初期化が「感情距離」の幾何を低次元で大域的に保存。テンセグリティの片側拘束＋PBD で自己支持的な安定形へ漸近（ストレス最小化の近似）。アンカーとグローバル場（殻/トーラス/斥力）で、辺縁系の環状・層状のマクロ形態を制御。"
        },
        {
          "@id": "project:documentation:readme:section:12",
          "title": "今後の改善",
          "content": "ランチョス近似による固有分解の高速・高安定化。アンカー強度の UI 化（全体倍率／感情別係数）。σ 自動推定のロバスト化（k-NN 距離分布ベース等）。アンカーと語の双方向テンセグリティ（一部圧縮バー化）の最適化。"
        }
      ],
      "implementationFiles": [
        "apps/researcher/src/components/TimelineVisualization.tsx",
        "apps/researcher/src/components/Force3DWordGraph.tsx"
      ]
    },
    "researcherReadme": {
      "@id": "project:documentation:researcherReadme",
      "@type": "project:ResearcherReadme",
      "title": "Spirit in Physics - Researcher",
      "migrationStatus": "PostgreSQL + GraphQL Migration Complete",
      "description": "This visualizer has been fully migrated to PostgreSQL + TimescaleDB with GraphQL API (Rust + async-graphql + sqlx).",
      "keyChanges": {
        "database": {
          "before": "Neo4j graph database (removed)",
          "after": "PostgreSQL + TimescaleDB (relational database with time-series extensions)"
        },
        "apiLayer": {
          "before": "Neo4j Cypher queries (removed)",
          "after": "GraphQL API (Rust service using async-graphql + sqlx)"
        },
        "dataAccess": {
          "before": "Direct Neo4j client calls (removed)",
          "after": "GraphQL queries and mutations"
        }
      },
      "graphqlApiFeatures": [
        "Type-safe queries and mutations",
        "PostgreSQL connection pooling via sqlx",
        "TimescaleDB for efficient time-series data storage",
        "Async/await support for high performance"
      ],
      "configuration": {
        "databaseUrl": "postgresql://postgres:postgres@postgres:5432/spirit_in_physics"
      },
      "migrationBenefits": [
        "Type Safety: TypeScript interfaces maintained via GraphQL codegen",
        "Performance: Efficient SQL queries with connection pooling",
        "Scalability: PostgreSQL + TimescaleDB for time-series data",
        "Consistency: Unified GraphQL API across the application",
        "Standard SQL: Easier to maintain and debug than Cypher queries"
      ],
      "timeline3dForceMode": {
        "path": "participants/[id]/timeline",
        "description": "表示モードトグルに「3D Force」を追加",
        "implementation": "src/components/Force3DWordGraph.tsx",
        "nodes": "単語ごとに集約し、`scale = normalize(avgReactionValue * log(1+count))`",
        "edges": "完全グラフ（全組合せ）、`weight = normalize(raw_i * raw_j)`",
        "rendering": "@react-three/fiber + three。カメラ・回転は OrbitControls"
      },
      "apiEndpoints": [
        "GET /api/participants - List all participants",
        "GET /api/participants/[id] - Get participant details",
        "GET /api/participants/[id]/results - Get analysis results",
        "GET /api/dashboard-stats - Get dashboard statistics"
      ]
    },
    "postgresqlMigration": {
      "@id": "project:documentation:postgresqlMigration",
      "@type": "project:PostgreSQLMigration",
      "title": "Neo4jからPostgreSQL + Dieselへの移行計画",
