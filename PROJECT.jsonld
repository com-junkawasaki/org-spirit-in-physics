  "@id": "http://spirit.localhost/project",
  "@type": "project:Project",
  "title": "いい感じの社会の物語",
  "description": "Spirit in Physicsプロジェクト - 科学的手法による霊性測定システム",
  "version": "2.2.0",
  "author": "Jumma Kawasaki",
  "createdAt": "2024-01-01T00:00:00+09:00",
  "updatedAt": "2026-01-14T00:00:00+09:00",
  "merkleRoot": "Bilingual paper PDFs (ja/en) generated with philosophical rationale: negation of individual, open system thermodynamics.",
  "story": {
    "@id": "project:story",
    "@type": "project:Story",
    "protagonist": {
      "@id": "project:protagonist",
      "@type": "project:Protagonist",
      "name": "河崎純真",
      "epithet": "社会起業家",
      "lifespan": "享年100歳",
      "legacy": "人々が満たされた人生を送れる社会を築いた"
    },
    "narrative": [
      {
        "@id": "project:narrative/93",
        "@type": "project:Narrative",
        "act": "英語版論文 PDF の生成（Paraglide 翻訳ベース）",
        "summary": "Paraglide で管理された英語翻訳（en.js）を基に、日本語版と同等の構成で英語版論文 PDF（paper_en.pdf）を生成。'Why Spirit: The Negation of the Individual' セクションを含む完全な哲学的根拠を英語で記述し、国際的な学術発表に対応可能な形式とした。"
      },
      {
        "@id": "project:narrative/92",
        "@type": "project:Narrative",
        "act": "「精神」から「霊性」への用語変更と哲学的根拠の追記",
        "summary": "論文の核心的用語を「精神（mind）」から「霊性（spirit）」へ全面的に変更。その根拠として、(1) 心は場・身体・他者と分離独立していない、(2) 人間は開放系の熱力学的情報場である、(3) individual（不可分の個体）の否定、という存在論的主張を論文の導入部に追加。Paraglide 日本語メッセージファイルの全26箇所を更新し、PDF を再生成した。"
      },
      {
        "@id": "project:narrative/91",
        "@type": "project:Narrative",
        "act": "論文の日本語版 PDF 生成とドキュメント化",
        "summary": "多言語対応（Paraglide）された論文コンテンツから日本語メッセージを抽出し、学術的な Markdown 形式で再構成。LuaLaTeX エンジンと pandoc を用いて、数式（LaTeX）や構造を維持した高品質な日本語 PDF 論文を生成した。"
      },
      {
        "@id": "project:narrative/90",
        "@type": "project:Narrative",
        "act": "GKE Autopilot への移行とコスト最適化",
        "summary": "インフラコスト最適化のため、GKE Standard から Autopilot への移行を完了。不要なミドルウェア（MinIO, lakeFS）を廃止し、Google Cloud Storage (GCS) を直接利用する構成へ刷新。データの永続性を確保しつつ、アイドル時のコストを最小化。"
      },
      {
        "@id": "project:narrative/89",
        "@type": "project:Narrative",
        "act": "モバイル・レイアウトの最適化と Clerk 認証フォールバックの実装",
        "summary": "モバイルアプリにおけるレイアウトの二重表示（Header/Footer）を解消し、Apple HIG に準拠した一貫性のある UI を確立。Capacitor 環境での環境変数置換不全を想定した Clerk 認証キーの安全なフォールバックを `env.svelte.ts` に実装。実験ルートにおける没入感を高めるため、計測中はタブバーを動的に隠蔽するロジックを統合し、ユーザーが精神探索に集中できる環境を整えた。"
      },
      {
        "@id": "project:narrative/88",
        "@type": "project:Narrative",
        "act": "実験フローのナラティブ化と没入型 UI/UX の実装",
        "summary": "実験開始から結果表示までを「自己探求の物語」として再設計。VoidBackground による精神空間の視覚化、ステップ式のナラティブ同意フォーム、計測中の没入型 Void Mode、および解析の儀式（Manifestation）アニメーションを実装。結果画面もダイナミックな 3D ポートレートとして刷新し、科学的な没入感を極限まで高めた。"
      },
      {
        "@id": "project:narrative/87",
        "@type": "project:Narrative",
        "act": "論文閲覧体験のモバイル最適化 (Apple HIG 準拠)",
        "summary": "iPhone 等のモバイル端末における論文の読みやすさを改善。Apple Human Interface Guidelines に基づき、フォントサイズのスケーリング、余白の再設計（6rem -> 1.5rem）、および親指での操作を考慮した TOC ボタンのフローティング配置（Bottom-heavy Interaction）を実装。学術的な格調高さを維持しつつ、現代的な iOS アプリの読書体験を実現した。"
      },
      {
        "@id": "project:narrative/86",
        "@type": "project:Narrative",
        "act": "基準個体（河崎純真）データの高密度可視化とモバイル最適化",
        "summary": "河崎純真の spirit データ（n=150ノード以上）をデフォルトサンプルとして統合。モバイル端末の縦長画面に最適化したカメラ制御、ノードごとの発光（Radial Glow）エフェクト、および Ghost Pattern に基づく空間全体の環境光レンダリングを実装。Nature Physics 掲載を見据えた、没入感の高い 3D 多様体表現を実現した。"
      },
      {
        "@id": "project:narrative/85",
        "@type": "project:Narrative",
        "act": "iOS シミュレータでのモバイルアプリ起動とネイティブ統合の検証",
        "summary": "Capacitor プロジェクトのビルドと同期を行い、iOS シミュレータでのアプリ起動プロセスを確立。SvelteKit 側への Capacitor 依存関係の追加、iOS Deployment Target の引き上げ（iOS 14.0）、およびネイティブ録音プラグインの統合により、モバイル特有の計測安定性を確保した。"
      },
      {
        "@id": "project:narrative/84",
        "@type": "project:Narrative",
        "act": "Capacitor による iOS/Android モバイルアプリ (apps/mobile) の初期化",
        "summary": "n=1,000 の目標達成に向けた戦略的アプローチとして、ネイティブアプリ化を決定。apps/mobile を Capacitor で構築し、iOS/Android プラットフォームを初期化。既存の SvelteKit (SSG) 資産をモバイルアプリとしてパッケージングする基盤を構築した。"
      },
      {
        "@id": "project:narrative/83",
        "@type": "project:Narrative",
        "act": "n=1,000 に向けた公開用ルート (/experiment) の構築とモバイル最適化",
        "summary": "n=1,000 のサンプルサイズ拡大を目指し、摩擦の少ない一般公開用実験ルート（/experiment）を実装。Clerk を用いた Email OTP（ワンタイムパスワード）認証を統合し、モバイル端末でのタッチ操作対応、OGP によるソーシャルシェア機能、およびデバイス権限取得のガイダンスを統合し、広範なユーザー参加を可能にする基盤を構築した。"
      },
      {
        "@id": "project:narrative/82",
        "@type": "project:Narrative",
        "act": "基準個体データの解析強化と可視化の高度化",
        "summary": "河崎純真を基準個体（Sample）として、幾何学的な Ghost Pattern 検出ロジックを 3D Force Graph に統合。異常密集（Complex Core）や特異的空白（Repression Gap）を紫色のグロー効果と注釈で可視化し、生体反応による空間歪曲を直感的に把握可能にした。"
      },
      {
        "@id": "project:narrative/81",
        "@type": "project:Narrative",
        "act": "幾何学的 Ghost Pattern 検出の実装と理論統合",
        "summary": "ベクトル空間における「生体反応（生理指標・行動指標）」を距離関数に組み込んだ Ghost Pattern 検出アルゴリズムを実装。異常密集（Complex Core）や特異的空白（Repression Gap）を幾何学的に特定するロジックを Temporal ワークフローに統合し、ARCHITECTURE.jsonld を最新の定義にアップデートした。"
      },
      {
        "@id": "project:narrative/80",
        "@type": "project:Narrative",
        "act": "理論モデルの定式化と基準個体の設定",
        "summary": "論文の核心となる「精神物理空間」および「情報エネルギーの関数微分」の数学的定義を ARCHITECTURE.jsonld に集約。主人公・河崎純真を、高度な情報統合を体現する基準個体（Sample）としてモデル内に位置づけた。"
      },
      {
        "@id": "project:narrative/79",
        "@type": "project:Narrative",
        "act": "Nature 掲載戦略の策定と構造化",
        "summary": "研究を Nature Physics 等のトップジャーナルへ掲載するための戦略を策定。n=1,000 を目標としたサンプルサイズ拡大、Ghost Pattern の自動検出、再現性パッケージの構築を柱とする STRATEGY.jsonld を作成した。"
      },
      {
        "@id": "project:narrative/78",
        "@type": "project:Narrative",
        "act": "ランディングページのセクション分割とUI改善",
        "summary": "ヒーローセクションの3D可視化とエントリーカードが重なって見づらいという課題に対し、ページを「視覚的ヒーロー（Visual Hero）」と「アクション（Entry Cards）」の2つの独立したセクションに分割。スクロールによる没入感を維持しつつ、情報の可読性を大幅に向上させた。"
      },
      {
        "@id": "project:narrative/77",
        "@type": "project:Narrative",
        "act": "ランディングページの視覚的・データ的強化",
        "summary": "トップページの「SPIRIT IN PHYSICS」セクションにスクロール連動アニメーション（フェード、スケール、ブラー）を導入し、ユーザー体験をより直感的かつ洗練されたものにした。また、背景の3D Force Graphに実際の被験者データ（imai）を統合し、ダミーデータではなく本物の「心のmanifold」が可視化されるように実装を刷新した。"
      },
      {
        "@id": "project:narrative/76",
        "@type": "project:Narrative",
        "act": "同意説明文書の多言語統合とUI洗練",
        "summary": "ResearchPlanContent.svelteをParaglide i18nに統合し、詳細な研究計画書を日・英で提供可能にした。また、ConsentFormのUIをオリジナルのtsxデザインに基づき洗練。Tailwindによるダークモード対応と、CDISC準拠の属性収集、ICD-10疾患コードサジェスト機能を含む統合的な同意フローを完成させた。"
      },
      {
        "@id": "project:narrative/75",
        "@type": "project:Narrative",
        "act": "同意プロセスと属性収集の標準化",
        "summary": "研究参加同意フォームを刷新した。CDISC標準に基づく属性情報収集と、ICD-10準拠の疾患コードサジェスト機能を導入。Paraglide i18n統合により、グローバルな臨床研究基準（ICH-GCP）に適合するユーザー体験を構築し、バックエンド（gRPC/Protobuf）への永続化ロジックまでを統合した。"
      }
    ]
  },
  "metadata": {
    "@id": "project:metadata",
