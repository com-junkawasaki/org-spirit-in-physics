  "@id": "http://spirit.localhost/project",
  "@type": "project:Project",
  "title": "いい感じの社会の物語",
  "description": "Spirit in Physicsプロジェクト - 科学的手法による霊性測定システム",
  "version": "1.45.0",
  "author": "Jumma Kawasaki",
  "createdAt": "2024-01-01T00:00:00+09:00",
  "updatedAt": "2025-12-27T16:00:00+09:00",
  "merkleRoot": "polydam を除外し lakeFS に一本化したストレージ管理体制を構築。Kubernetes 上でのデータバージョン管理と整合性を確保。",
  
  "story": {
    "@id": "project:story",
    "@type": "project:Story",
    "protagonist": {
      "@id": "project:protagonist",
      "@type": "project:Protagonist",
      "name": "河崎純真",
      "epithet": "社会起業家",
      "lifespan": "享年100歳",
      "legacy": "人々が満たされた人生を送れる社会を築いた"
    },
    "narrative": [
      {
        "@id": "project:narrative/70",
        "@type": "project:Narrative",
        "act": "データレイクのバージョン管理導入",
        "summary": "データ管理基盤を Pachyderm から lakeFS に刷新。lakeFS を Kubernetes インフラ (Timoni) に統合し、Storage Service からの Git ライクなデータ操作（リポジトリ、ブランチ管理）の基礎を確立した。これにより、測定データの大規模な再現性と系統管理が容易になった。"
      }
    ]
  },
  "metadata": {
    "@id": "project:metadata",
    "@type": "project:Metadata",
    "implementedFeatures": [
      "SvelteKit パスベースルーティングの実装 (/paper, /researcher, /participant, /demo)",
      "Python Temporal SDK を使用したインポーターの再構築",
      "ImportParticipantsWorkflow, ImportSessionsWorkflow の実装",
      "Python Temporal Worker の作成とデータベース連携",
      "FastAPI エンドポイントからの Temporal ワークフロー起動処理の実装",
      "Tiltfile 作成と統合",
      "Svelte アプリの Live Update 実装",
      "Timoni Bundle の Tilt 連携",
      "BDD テストの Tilt リソース化",
      "gRPC Service Dockerfile のクリーンアップ",
      "Storage Service (gRPC) との連携実装",
      "MinIO の Kubernetes クラスターへの統合",
      "Temporal を使用したデータインポーター（Workflow/Activity）の設計と実装 (Go/Python 両対応)",
      "Next.js 版 researcher アプリの完全廃止と SvelteKit への統合",
      "3D Force 可視化 (Force3DWordGraphTypeGPU) の Svelte 実装",
      "KPI カード、時系列チャート (TimelineChart)、構造分析パネル Svelte 実装",
      "SvelteKit への /researcher/participants/[id] ルート追加と ConnectRPC 連携",
      "Go 版 gRPC サービスの GetTimeline 処理を Temporal Workflow/Activity に移行",
      "全サービス（API, Import, Temporal UI, MinIO）を spirit.localhost へのパスベースルーティングに統一",
      "SvelteKit ビルドの成功と SPA 向け prerender 設定の最適化",
      "gRPC サービスにおける /api パスプレフィックスのストリップ処理実装と HasPrefix による堅牢化",
      "データ管理基盤の lakeFS への移行と Timoni 構成への統合",
      "Storage Service の lakeFS S3 Gateway 連携実装",
      "lakeFS 自動セットアップ用の Kubernetes Job (LakeFSSetupJob) の実装",
      "dataset の git-annex による管理とポインタファイル化の完了",
      "ストレージ管理（MinIO, lakeFS）の Kubernetes (Timoni/Tilt) での統合管理体制の確立",
      "Temporal TypeScript Worker への BDD テスト実行機能の統合",
      "Playwright + Cucumber.js によるブラウザ E2E テストの Temporal ワークフロー化",
      "研究者ポータルへのテストモード（Auth バイパス）の実装と BDD 連携",
      "Svelte アプリの配信基盤を Nginx から Envoy + Python SPA Server に移行",
      "SvelteKit のパス解決を絶対パスに固定し、SPA ルーティングの整合性を確保",
      "特定の被験者 (e41a9cd2-d803-49a8-9020-0260e55cd03e) の分析可視化 BDD シナリオのパス",
      "Timoni app/infra モジュールの Nginx から Envoy への移行完了",
      "Timoni モジュールのデフォルト設定（ConfigMap, Deployment, README）を Envoy ベースに刷新",
      "Nix Flake による決定論的ビルド環境の導入 (flake.nix, devenv)",
      "gRPC サービスの Nix 派生 (buildGoModule) と OCI イメージ生成の自動化",
      "Svelte アプリの Nix 派生 (pnpm.fetchDeps) による再現可能なビルドの実現",
      "OCI イメージのタグを Nix ハッシュに基づいた管理へ移行する基盤の確立"
    ]
  }
}
