  "@id": "https://spirit-in-physics.gftd.ai/project",
  "@type": "project:Project",
  "title": "いい感じの社会の物語",
  "description": "Spirit in Physicsプロジェクト - 科学的手法による霊性測定システム",
  "version": "1.44.0",
  "author": "Jumma Kawasaki",
  "createdAt": "2024-01-01T00:00:00+09:00",
  "updatedAt": "2025-12-26T20:00:00+09:00",
  "merkleRoot": "Tilt による開発環境のオーケストレーション統合完了: Tiltfile の作成、Go gRPC サービスと Svelte アプリのビルド自動化、Live Update (Svelte) の実装、Timoni との連携、および BDD テストの Tilt UI からの実行管理。開発サイクルの高速化とログの統合監視を実現。",
  
  "story": {
    "@id": "project:story",
    "@type": "project:Story",
    "protagonist": {
      "@id": "project:protagonist",
      "@type": "project:Protagonist",
      "name": "河崎純真",
      "epithet": "社会起業家",
      "lifespan": "享年100歳",
      "legacy": "人々が満たされた人生を送れる社会を築いた"
    },
    "narrative": [
      {
        "@id": "project:narrative/67",
        "@type": "project:Narrative",
        "act": "Tiltによる開発体験の極大化",
        "summary": "開発フィードバックループを加速させるため Tilt を導入。Timoni によるインフラ適用、Go/Svelte のビルド、K8s へのデプロイ、そして BDD テストの実行を一つのダッシュボードに統合。Live Update によりフロントエンドの変更は即座にブラウザに反映され、バックエンドの修正も自動的にデプロイされる環境を整えた。"
      }
    ]
  },
  "metadata": {
    "@id": "project:metadata",
    "@type": "project:Metadata",
    "implementedFeatures": [
      "Tiltfile 作成と統合",
      "Svelte アプリの Live Update 実装",
      "Timoni Bundle の Tilt 連携",
      "BDD テストの Tilt リソース化",
      "gRPC Service Dockerfile のクリーンアップ",
      "リソースのラベルグルーピング (infra, backend, frontend, test)",
      "WebM 音声・映像保存機能の設計と実装",
      "画像（スナップショット）保存機能の実装",
      "Storage Service (gRPC) との連携実装",
      "MinIO の Kubernetes クラスターへの統合",
      "MinIO Go SDK を使用したストレージハンドラーの実装",
      "Svelte による研究者ポータル (Admin Dashboard) の設計と実装",
      "被験者一覧、セッション履歴、アナリティクス概要コンポーネントの実装",
      "Temporal を使用したデータインポーター（Workflow/Activity）の設計と実装",
      "Connect RPC 経由でのインポート実行環境の整備"
    ]
  }
}
