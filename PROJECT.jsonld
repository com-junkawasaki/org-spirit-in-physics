  "@id": "https://spirit-in-physics.gftd.ai/project",
  "@type": "project:Project",
  "title": "いい感じの社会の物語",
  "description": "Spirit in Physicsプロジェクト - 科学的手法による霊性測定システム",
  "version": "1.43.0",
  "author": "Jumma Kawasaki",
  "createdAt": "2024-01-01T00:00:00+09:00",
  "updatedAt": "2025-12-26T19:30:00+09:00",
  "merkleRoot": "Temporal Go による TDD/BDD ワークフロー基盤構築完了: OnboardingWorkflow と ParticipantActivities の Go 実装、testsuite による TDD (Red->Green) 実装、Cucumber.js による BDD (Onboarding Scenario) の Pass を確認。ParticipantHandler への Temporal 統合と main.go での Worker 起動設定完了。sqlc/pgtype 互換性問題を全面的に修正し、クリーンなビルドとテストを達成。",
  
  "story": {
    "@id": "project:story",
    "@type": "project:Story",
    "protagonist": {
      "@id": "project:protagonist",
      "@type": "project:Protagonist",
      "name": "河崎純真",
      "epithet": "社会起業家",
      "lifespan": "享年100歳",
      "legacy": "人々が満たされた人生を送れる社会を築いた"
    },
    "narrative": [
      {
        "@id": "project:narrative/66",
        "@type": "project:Narrative",
        "act": "Temporalによる高信頼ワークフローの確立",
        "summary": "Temporal Workflow を用いた高信頼なデータ処理基盤を Go で構築。被験者の登録から環境設定、通知までの一連のプロセスをワークフローとして定義し、TDD (Temporal testsuite) と BDD (Cucumber.js + Gherkin) を用いてその振る舞いを厳密に検証。sqlc/pgtype のマッピング問題を解決し、DB 操作を含む Activity の堅牢性を向上させた。"
      }
    ]
  },
  "metadata": {
    "@id": "project:metadata",
    "@type": "project:Metadata",
    "implementedFeatures": [
      "Temporal Go SDK 統合",
      "OnboardingWorkflow 実装",
      "ParticipantActivities 実装",
      "Temporal testsuite による TDD 実装",
      "Cucumber.js によるワークフロー BDD 検証",
      "Go Handler への Temporal Client 統合",
      "main.go での Temporal Worker 起動設定",
      "sqlc/pgtype 互換性問題の完全修正",
      "session_events テーブルへの正しい pgtype マッピング"
    ]
  }
