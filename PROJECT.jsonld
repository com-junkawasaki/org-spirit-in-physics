  "metadata": {
    "@id": "project:metadata",
    "@type": "project:Metadata",
    "analysisMethods": [
      {
        "@id": "project:analysisMethod/participant-emotion-analysis",
        "@type": "project:AnalysisMethod",
        "name": "Hume AI Emotion Analysis",
        "description": "Video file emotion analysis using Hume Expression Measurement API",
        "algorithm": "Hume AI Expression Measurement API batch processing with face FACS and descriptions models",
        "parameters": {
          "models": {
            "face": {
              "facs": {},
              "descriptions": {}
            }
          },
          "processingTime": "tracked per analysis"
        },
        "results": {
          "emotionStatistics": "generated via foldEmotionStatistics",
          "emotionScores": "per emotion type (happiness, sadness, surprise, etc.)"
        },
        "appliesTo": ["participant"]
      },
      {
        "@id": "project:analysisMethod/importer-data-import",
        "@type": "project:AnalysisMethod",
        "name": "Data Import Service",
        "description": "Python FastAPI-based import service for participants, sessions, emotions, and timeline data",
        "algorithm": "Transaction-based data insertion with asyncpg, validation, and error handling",
        "parameters": {
          "emotionScoreThreshold": 0.1,
          "timeRangeMatching": "±2 seconds",
          "topEmotionsPerFileType": 5,
          "emotionNormalization": "48+ emotion types → standard categories"
        },
        "results": {
          "importedParticipants": "count",
          "importedSessions": "count",
          "importedEmotions": "count",
          "generatedTimelinePoints": "count"
        },
        "appliesTo": ["importer"]
      },
      {
        "@id": "project:analysisMethod/kawasaki-model",
        "@type": "project:AnalysisMethod",
        "name": "Kawasaki Model Spirit Probability Calculation",
        "description": "Complete probability model integrating Word2Vec, reaction time, skin potential, and emotion",
        "algorithm": "P(w_O | w_I) = exp(w_I · w_O) · [r(w_I, w_O)]^α · exp(γ·ΔSP/λ) · exp(η·F(w_I, w_O)) / Σ",
        "parameters": {
          "alpha": "reaction time exponent (default: 1.0)",
          "gamma": "ΔSP coefficient (default: 1.0)",
          "lambda": "ΔSP scale (default: 1.0)",
          "eta": "emotion coefficient (default: 1.0)",
          "epsilon": "reaction time smoothing factor (1e-3)"
        },
        "results": {
          "averageSpiritProbability": 0.9999,
          "highSpiritResponses": "count (>0.8)",
          "componentBreakdown": {
            "word2vec": "semantic similarity component",
            "reactionTime": "r(w_I, w_O) = 1/(T(w_I, w_O) + ε)",
            "skinPotential": "exp(γ·ΔSP/λ)",
            "emotion": "exp(η·F(w_I, w_O))"
          },
          "statisticalMetrics": {
            "mean": "average spirit probability",
            "max": "maximum spirit probability",
            "min": "minimum spirit probability",
            "stdDeviation": "standard deviation"
          }
        },
        "appliesTo": ["researcher"]
      },
      {
        "@id": "project:analysisMethod/3d-force-graph",
        "@type": "project:AnalysisMethod",
        "name": "3D Force Graph Visualization",
        "description": "WebGPU-based force-directed graph layout for word-emotion relationships",
        "algorithm": "Force-directed graph with spring forces, repulsion forces, shell forces, and radial forces",
        "parameters": {
          "springK": 2.0,
          "repulsionK": 2000.0,
          "restLength": 80,
          "damping": 0.92,
          "shellRadius": 300,
          "shellK": 1.5,
          "radialOutK": 120,
          "minSep": 80,
          "sepK": 8000,
          "topK": "sparse graph generation",
          "minW": "minimum weight threshold",
          "weightGamma": "weight scaling factor"
        },
        "results": {
          "nodePositions": "emotion anchors on spherical shell, words at weighted centroid",
          "graphStructure": "Top-K sparse graph with minimum distance constraints",
          "visualization": "interactive 3D force graph with emotion-colored nodes and links"
        },
        "optimization": {
          "viewportVisibility": "Intersection Observer APIによるビューポート可視性監視",
          "performanceOptimization": "可視エリア外でのWebGPU処理停止",
          "rootMargin": "50px",
          "threshold": 0.01
        },
        "appliesTo": ["researcher"]
      },
      {
        "@id": "project:analysisMethod/timeline-visualization",
        "@type": "project:AnalysisMethod",
        "name": "Timeline Visualization",
        "description": "Time-series data integration and visualization",
        "algorithm": "Word display event detection, physiological data aggregation (8 channels), emotion data integration (burst, face, language, prosody)",
        "parameters": {
          "timeRange": "filterable time range",
          "modalities": ["burst", "face", "language", "prosody"],
          "physiologicalChannels": 8
        },
        "results": {
          "timelinePoints": "integrated data points with timestamps",
          "wordDisplayEvents": "detected events",
          "physiologicalData": "aggregated per channel",
          "emotionData": "integrated per modality"
        },
        "appliesTo": ["researcher"]
      },
      {
        "@id": "project:analysisMethod/structure-analysis",
        "@type": "project:AnalysisMethod",
        "name": "Structure Analysis",
        "description": "Gap area detection, density region analysis, and duplicate detection",
        "algorithm": "3D space analysis for sparse regions, clustered word groups, and similar word pairs",
        "parameters": {
          "minGapRadius": 50,
          "maxGapRadius": 200,
          "minNearbyNodes": 3,
          "gridResolution": 40,
          "densityThreshold": 0.1
        },
        "results": {
          "gapAreas": "sparse regions in 3D space",
          "densityRegions": "clustered word groups",
          "duplicates": "similar word pairs",
          "overallDensity": "density metric"
        },
        "appliesTo": ["researcher"]
      },
      {
        "@id": "project:analysisMethod/emotion-distance",
        "@type": "project:AnalysisMethod",
        "name": "Emotion Distance Visualization",
        "description": "Multi-dimensional distance calculation for word-emotion relationships",
        "algorithm": "Distance methods: Cosine, Weighted Cosine, Gower, Combined (Cosine + Soft-DTW), Fusion (Kernel CKA). Embedding methods: PCA, UMAP, Force Layout",
        "parameters": {
          "distanceMethod": "cosine | weighted_cosine | gower | combined | fusion",
          "embeddingMethod": "pca | umap | force",
          "dimensions": 2 | 3,
          "k": 6,
          "gamma": 0.1,
          "alpha": 0.6,
          "weights": {
            "emotion": 0.4,
            "reactionValue": 0.2,
            "reactionTime": 0.2,
            "physiological": 0.2
          }
        },
        "results": {
          "distanceMatrix": "pairwise distances between words",
          "embeddings": "dimensionality-reduced representations",
          "clusters": "word clusters based on distance"
        },
        "appliesTo": ["researcher"]
      }
    ],
