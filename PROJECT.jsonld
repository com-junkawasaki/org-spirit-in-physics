  "id": "https://spirit-in-physics.gftd.ai/project",
  "type": "ex:Project",
  "name": "Spirit-in-Physics Visualizer — Emotion-Kernel Tensegrity 3D Model",
  "description": "感情に誘導された距離（メトリック／カーネル）で語集合に幾何（距離空間）を与え、その距離を最もよく保存するように低次元へ埋め込み、さらにテンセグリティ物理で自己支持的な立体構造へ収束させるモデル。科学的手法により霊性を可視化・測定可能にする研究プロジェクト。",
  "version": "1.24.0",
  "createdAt": "2024-10-02T00:00:00+09:00",
  "updatedAt": "2025-01-04T00:00:00+09:00",
  "status": "active",
  "tags": ["research", "spirituality", "emotion-analysis", "3d-visualization", "tensegrity", "hume-ai", "supabase", "nextjs", "typescript"],
  
  "goal": {
    "id": "https://spirit-in-physics.gftd.ai/goal",
    "type": "ex:Goal",
    "description": "我らと我らの子孫が豊かで情緒的な暮らしを送れるいい感じの社会を生成する",
    "realizedBy": "https://spirit-in-physics.gftd.ai/project"
  },
  
  "narrative": [
    {
      "id": "https://spirit-in-physics.gftd.ai/narrative/spirit-in-physics",
      "type": "ex:Narrative",
      "act": "Spirit in Physics",
      "summary": "医学博士である河崎純真が、エホバの証人、科学哲学、仏教、アヤワスカ、コンピューターの経験を通して、クリスチャンのアンタッチャブルな「spirit」を可視化・提供可能にし、神と人、霊と人を統合する試み。"
    },
    {
      "id": "https://spirit-in-physics.gftd.ai/narrative/kawasaki-model",
      "type": "ex:Narrative",
      "act": "川崎モデルの誕生",
      "summary": "河崎純真はユングの単語連合テストを現代的な技術で再現し、感情分析と生理データを統合した「川崎モデル」を開発。参加者の顔表情、声の調子、皮膚電位をHume AIで解析し、Word2Vecによる意味ベクトルと組み合わせることで、言語と感情の関係性を定量的に表現する画期的な手法を生み出した。"
    },
    {
      "id": "https://spirit-in-physics.gftd.ai/narrative/integration",
      "type": "ex:Narrative",
      "act": "完全統合システムの完成",
      "summary": "Spirit in Physicsプロジェクトの完全統合システムを実現。Hume AIデータベース統合API、管理者ダッシュボード、分析パイプライン、参加者アプリの全てが連携し、実験開始から分析結果閲覧までの一気通貫のワークフローを確立。"
    }
  ],
  
