  "@id": "http://spirit.localhost/project",
  "@type": "project:Project",
  "title": "いい感じの社会の物語",
  "description": "Spirit in Physicsプロジェクト - 科学的手法による霊性測定システム",
  "version": "1.56.4",
  "author": "Jumma Kawasaki",
  "createdAt": "2024-01-01T00:00:00+09:00",
  "updatedAt": "2026-01-04T00:00:00+09:00",
  "merkleRoot": "Established Nature publication strategy and created STRATEGY.jsonld to guide scaling to n=1000.",
  "story": {
    "@id": "project:story",
    "@type": "project:Story",
    "protagonist": {
      "@id": "project:protagonist",
      "@type": "project:Protagonist",
      "name": "河崎純真",
      "epithet": "社会起業家",
      "lifespan": "享年100歳",
      "legacy": "人々が満たされた人生を送れる社会を築いた"
    },
    "narrative": [
      {
        "@id": "project:narrative/79",
        "@type": "project:Narrative",
        "act": "Nature 掲載戦略の策定と構造化",
        "summary": "研究を Nature Physics 等のトップジャーナルへ掲載するための戦略を策定。n=1,000 を目標としたサンプルサイズ拡大、Ghost Pattern の自動検出、再現性パッケージの構築を柱とする STRATEGY.jsonld を作成した。"
      },
      {
        "@id": "project:narrative/78",
        "@type": "project:Narrative",
        "act": "ランディングページのセクション分割とUI改善",
        "summary": "ヒーローセクションの3D可視化とエントリーカードが重なって見づらいという課題に対し、ページを「視覚的ヒーロー（Visual Hero）」と「アクション（Entry Cards）」の2つの独立したセクションに分割。スクロールによる没入感を維持しつつ、情報の可読性を大幅に向上させた。"
      },
      {
        "@id": "project:narrative/77",
        "@type": "project:Narrative",
        "act": "ランディングページの視覚的・データ的強化",
        "summary": "トップページの「SPIRIT IN PHYSICS」セクションにスクロール連動アニメーション（フェード、スケール、ブラー）を導入し、ユーザー体験をより直感的かつ洗練されたものにした。また、背景の3D Force Graphに実際の被験者データ（imai）を統合し、ダミーデータではなく本物の「心のmanifold」が可視化されるように実装を刷新した。"
      },
      {
        "@id": "project:narrative/76",
        "@type": "project:Narrative",
        "act": "同意説明文書の多言語統合とUI洗練",
        "summary": "ResearchPlanContent.svelteをParaglide i18nに統合し、詳細な研究計画書を日・英で提供可能にした。また、ConsentFormのUIをオリジナルのtsxデザインに基づき洗練。Tailwindによるダークモード対応と、CDISC準拠の属性収集、ICD-10疾患コードサジェスト機能を含む統合的な同意フローを完成させた。"
      },
      {
        "@id": "project:narrative/75",
        "@type": "project:Narrative",
        "act": "同意プロセスと属性収集の標準化",
        "summary": "研究参加同意フォームを刷新した。CDISC標準に基づく属性情報収集と、ICD-10準拠の疾患コードサジェスト機能を導入。Paraglide i18n統合により、グローバルな臨床研究基準（ICH-GCP）に適合するユーザー体験を構築し、バックエンド（gRPC/Protobuf）への永続化ロジックまでを統合した。"
      }
    ]
  },
