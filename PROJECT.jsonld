  "@id": "https://spirit-in-physics.gftd.ai/project",
  "@type": "project:Project",
  "title": "いい感じの社会の物語",
  "description": "Spirit in Physicsプロジェクト - 科学的手法による霊性測定システム",
  "version": "1.45.0",
  "author": "Jumma Kawasaki",
  "createdAt": "2024-01-01T00:00:00+09:00",
  "updatedAt": "2025-12-27T12:45:00+09:00",
  "merkleRoot": "spirit.localhost ドメイン配下のパスベースルーティングを強化。Next.js 版 researcher アプリを /participants, /api, /_next パスへマッピングし、404 エラーを解消。SvelteKit ポータルと Next.js 分析画面の共存を実現。",
  
  "story": {
    "@id": "project:story",
    "@type": "project:Story",
    "protagonist": {
      "@id": "project:protagonist",
      "@type": "project:Protagonist",
      "name": "河崎純真",
      "epithet": "社会起業家",
      "lifespan": "享年100歳",
      "legacy": "人々が満たされた人生を送れる社会を築いた"
    },
    "narrative": [
      {
        "@id": "project:narrative/68",
        "@type": "project:Narrative",
        "act": "アーキテクチャの整理とスケーラビリティの向上",
        "summary": "フロントエンドのアクセス性を向上させるため、サブドメイン管理からディレクトリパス管理へ移行。また、Python によるデータインポーターを Temporal ワークフローとして再実装することで、大規模なデータインポート時の信頼性と可視性を確保した。"
      }
    ]
  },
  "metadata": {
    "@id": "project:metadata",
    "@type": "project:Metadata",
    "implementedFeatures": [
      "SvelteKit パスベースルーティングの実装 (/paper, /researcher, /participant, /demo)",
      "Python Temporal SDK を使用したインポーターの再構築",
      "ImportParticipantsWorkflow, ImportSessionsWorkflow の実装",
      "Python Temporal Worker の作成とデータベース連携",
      "FastAPI エンドポイントからの Temporal ワークフロー起動処理の実装",
      "Tiltfile 作成と統合",
      "Svelte アプリの Live Update 実装",
      "Timoni Bundle の Tilt 連携",
      "BDD テストの Tilt リソース化",
      "gRPC Service Dockerfile のクリーンアップ",
      "Storage Service (gRPC) との連携実装",
      "MinIO の Kubernetes クラスターへの統合",
      "Temporal を使用したデータインポーター（Workflow/Activity）の設計と実装 (Go/Python 両対応)",
      "被験者一覧の ID クリックによる詳細ページ遷移の修正",
      "可視化コンポーネントの共有パッケージ統合と Force3DControls の適用",
      "Gateway API によるパスベースルーティング (/participants, /api, /_next) の設定と 404 エラーの解消"
    ]
  }
}
