  "id": "https://spirit-in-physics.gftd.ai/resource/schema/Participant",
  "type": "ex:ResourceSchema",
  "name": {
    "en": "Participant Schema",
    "ja": "参加者スキーマ"
  },
  "description": {
    "en": "Database schema for participants table in Supabase",
    "ja": "Supabaseのparticipantsテーブルのデータベーススキーマ"
  },
  "createdAt": "2024-10-02T00:00:00+09:00",
  "updatedAt": "2025-01-04T00:00:00+09:00",
  
  "tableName": "participants",
  "primaryKey": "id",
  
  "columns": [
    {
      "name": "id",
      "type": "UUID",
      "nullable": false,
      "default": "gen_random_uuid()",
      "description": {"en": "Primary key", "ja": "主キー"}
    },
    {
      "name": "age",
      "type": "INTEGER",
      "nullable": true,
      "description": {"en": "Participant age", "ja": "参加者の年齢"}
    },
    {
      "name": "gender",
      "type": "gender_type",
      "nullable": true,
      "description": {"en": "Participant gender", "ja": "参加者の性別"},
      "enumValues": ["male", "female", "other", "prefer-not-to-say"]
    },
    {
      "name": "handedness",
      "type": "TEXT",
      "nullable": true,
      "description": {"en": "Participant handedness", "ja": "参加者の利き手"}
    },
    {
      "name": "created_at",
      "type": "TIMESTAMP WITH TIME ZONE",
      "nullable": false,
      "default": "NOW()",
      "description": {"en": "Creation timestamp", "ja": "作成タイムスタンプ"}
    },
    {
      "name": "updated_at",
      "type": "TIMESTAMP WITH TIME ZONE",
      "nullable": false,
      "default": "NOW()",
      "description": {"en": "Update timestamp", "ja": "更新タイムスタンプ"}
    }
  ],
  
  "indexes": [
    {
      "name": "idx_participants_created_at",
      "columns": ["created_at"],
      "description": {"en": "Index on created_at for sorting", "ja": "ソート用のcreated_atインデックス"}
    }
  ],
  
  "mapsTo": "https://spirit-in-physics.gftd.ai/ontology#Participant"
}

