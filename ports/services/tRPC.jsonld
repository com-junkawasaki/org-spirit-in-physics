{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://spirit-in-physics.gftd.ai/ontology#",
    "id": "@id",
    "type": "@type",
    
    "ex": "https://example.dev/ts#",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    
    "name": "dct:title",
    "description": "dct:description",
    "createdAt": {"@id": "dct:created", "@type": "xsd:dateTime"},
    "updatedAt": {"@id": "dct:modified", "@type": "xsd:dateTime"},
    
    "providedBy": {"@id": "ex:providedBy", "@type": "@id", "@container": "@set"},
    "routers": {"@id": "ex:routers", "@container": "@set"},
    "endpoints": {"@id": "ex:endpoints", "@container": "@set"}
  },
  
  "id": "https://spirit-in-physics.gftd.ai/port/services/tRPC",
  "type": "ex:ServicePort",
  "name": {
    "en": "tRPC Service Port",
    "ja": "tRPCサービスポート"
  },
  "description": {
    "en": "Service Port for tRPC API. Provides type-safe API endpoints with Zod validation. GraphQL契約ラッパ（クライアント・サーバ双方で使う型/バインド）",
    "ja": "tRPC APIのサービスポート。Zod検証付き型安全APIエンドポイントを提供。GraphQL契約ラッパ（クライアント・サーバ双方で使う型/バインド）"
  },
  "createdAt": "2024-10-02T00:00:00+09:00",
  "updatedAt": "2025-01-04T00:00:00+09:00",
  
  "providedBy": [
    "https://spirit-in-physics.gftd.ai/performer/service/DataCollectionService",
    "https://spirit-in-physics.gftd.ai/performer/service/AnalysisService"
  ],
  
  "protocol": "tRPC",
  "validation": "Zod",
  "typeSafety": "End-to-end TypeScript",
  
  "routers": [
    {
      "id": "https://spirit-in-physics.gftd.ai/router/participants",
      "name": {"en": "Participants Router", "ja": "参加者ルーター"},
      "path": "packages/trpc-routers/src/routers/participants.ts",
      "description": {"en": "Router for participant management", "ja": "参加者管理ルーター"}
    },
    {
      "id": "https://spirit-in-physics.gftd.ai/router/sessions",
      "name": {"en": "Sessions Router", "ja": "セッションルーター"},
      "path": "packages/trpc-routers/src/routers/sessions.ts",
      "description": {"en": "Router for session management", "ja": "セッション管理ルーター"}
    },
    {
      "id": "https://spirit-in-physics.gftd.ai/router/artifacts",
      "name": {"en": "Artifacts Router", "ja": "アーティファクトルーター"},
      "path": "packages/trpc-routers/src/routers/artifacts.ts",
      "description": {"en": "Router for artifact management", "ja": "アーティファクト管理ルーター"}
    },
    {
      "id": "https://spirit-in-physics.gftd.ai/router/analysis",
      "name": {"en": "Analysis Router", "ja": "解析ルーター"},
      "path": "packages/trpc-routers/src/routers/analysis.ts",
      "description": {"en": "Router for analysis execution", "ja": "解析実行ルーター"}
    },
    {
      "id": "https://spirit-in-physics.gftd.ai/router/emotions",
      "name": {"en": "Emotions Router", "ja": "感情ルーター"},
      "path": "packages/trpc-routers/src/routers/emotions.ts",
      "description": {"en": "Router for emotion data management", "ja": "感情データ管理ルーター"}
    }
  ],
  
  "endpoints": {
    "basePath": "/api/trpc",
    "protocol": "HTTP",
    "transport": "Fetch API"
  },
  
  "authentication": {
    "provider": "Clerk",
    "version": "v6.x"
  }
}

