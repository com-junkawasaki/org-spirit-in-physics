{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://spirit-in-physics.gftd.ai/ontology#",
    "id": "@id",
    "type": "@type",
    
    "ex": "https://example.dev/ts#",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    
    "name": "dct:title",
    "description": "dct:description",
    "createdAt": {"@id": "dct:created", "@type": "xsd:dateTime"},
    "updatedAt": {"@id": "dct:modified", "@type": "xsd:dateTime"},
    
    "status": "ex:status",
    "endpoints": {"@id": "ex:endpoints", "@container": "@set"}
  },
  
  "id": "https://spirit-in-physics.gftd.ai/port/services/GraphQL",
  "type": "ex:ServicePort",
  "name": {
    "en": "GraphQL Service Port",
    "ja": "GraphQLサービスポート"
  },
  "description": {
    "en": "Service Port for GraphQL API (future extension). GraphQL契約ラッパ（クライアント・サーバ双方で使う型/バインド）",
    "ja": "GraphQL APIのサービスポート（将来拡張用）。GraphQL契約ラッパ（クライアント・サーバ双方で使う型/バインド）"
  },
  "createdAt": "2024-10-02T00:00:00+09:00",
  "updatedAt": "2025-01-04T00:00:00+09:00",
  
  "status": "implemented",
  
  "protocol": "GraphQL",
  "federation": {
    "gateway": "https://gateway.gftd.ai/api/graphql",
    "microservices": "https://{servicename}.gftd.ai/api/graphql"
  },
  
  "endpoints": [
    {
      "path": "/graphql",
      "description": {"en": "GraphQL endpoint at app/graphql/route.ts", "ja": "app/graphql/route.tsのGraphQLエンドポイント"}
    }
  ],
  
  "implementation": {
    "status": "implemented",
    "path": "apps/researcher/src/app/graphql",
    "schema": "apps/researcher/src/app/graphql/schema-simple.ts",
    "route": "apps/researcher/src/app/graphql/route.ts",
    "framework": "graphql-js",
    "note": {"en": "GraphQL API implemented using graphql-js. Integrates with Rust activities server via HTTP.", "ja": "graphql-jsを使用してGraphQL APIを実装。HTTP経由でRust activitiesサーバーと統合。"}
  },
  
  "queries": [
    {
      "name": "participants",
      "description": {"en": "Get list of participants", "ja": "参加者一覧を取得"}
    },
    {
      "name": "participant",
      "description": {"en": "Get participant by ID", "ja": "IDで参加者を取得"}
    },
    {
      "name": "sessions",
      "description": {"en": "Get sessions (optionally filtered by participantId)", "ja": "セッションを取得（participantIdでフィルタリング可能）"}
    },
    {
      "name": "analysisResults",
      "description": {"en": "Get analysis results (optionally filtered by participantId or experimentId)", "ja": "解析結果を取得（participantIdまたはexperimentIdでフィルタリング可能）"}
    }
  ],
  
  "mutations": [
    {
      "name": "executeActivity",
      "description": {"en": "Execute a Rust activity via HTTP API", "ja": "HTTP API経由でRust activityを実行"},
      "args": {
        "activityId": {"type": "String!", "description": {"en": "Activity ID (JSON-LD @id)", "ja": "Activity ID（JSON-LD @id）"}},
        "inputs": {"type": "JSON!", "description": {"en": "Activity inputs", "ja": "Activity入力"}}
      }
    }
  ]
}

