{
  "@context": {
    "@version": 1.1,
    "id": "@id",
    "type": "@type",
    "cpm": "https://example.org/cpm#",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "sh": "http://www.w3.org/ns/shacl#",
    "dodaf": "http://dodaf.mil/dm2#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    
    "name": "rdfs:label",
    "description": "rdfs:comment",
    "wasAttributedTo": "prov:wasAttributedTo",
    "provides": "cpm:provides",
    "uiPort": "cpm:uiPort"
  },
  
  "@graph": [
    {
      "@id": "https://spirit-in-physics.gftd.ai/actor/researcher",
      "@type": ["cpm:Actor", "dodaf:Performer", "prov:Agent"],
      
      "name": "ResearcherActor",
      "description": "研究者向けアプリケーション（apps/researcher）。実験管理、データ分析、可視化のUI Portを提供する。",
      
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/capability/experiment-management",
        "https://spirit-in-physics.gftd.ai/capability/analysis",
        "https://spirit-in-physics.gftd.ai/capability/visualization"
      ],
      
      "provides": [
        {
          "@id": "https://spirit-in-physics.gftd.ai/actor/researcher/ui-port/dashboard",
          "@type": "cpm:UIPort",
          "name": "Dashboard UI Port",
          "description": "システムメトリクス表示、クイックアクション機能、詳細タブ（概要・参加者・インポート・分析）による包括的な管理インターフェース",
          "path": "/dashboard"
        },
        {
          "@id": "https://spirit-in-physics.gftd.ai/actor/researcher/ui-port/participants",
          "@type": "cpm:UIPort",
          "name": "Participants UI Port",
          "description": "参加者一覧テーブルページと詳細ページ。セッション数・応答数・平均Spirit確率・最終活動日時を表示",
          "path": "/participants"
        },
        {
          "@id": "https://spirit-in-physics.gftd.ai/actor/researcher/ui-port/visualization",
          "@type": "cpm:UIPort",
          "name": "Visualization UI Port",
          "description": "3D可視化、時系列可視化、インタラクティブダッシュボード",
          "path": "/participants/[id]"
        }
      ],
      
      "uiPort": [
        "https://spirit-in-physics.gftd.ai/actor/researcher/ui-port/dashboard",
        "https://spirit-in-physics.gftd.ai/actor/researcher/ui-port/participants",
        "https://spirit-in-physics.gftd.ai/actor/researcher/ui-port/visualization"
      ]
    }
  ]
}

