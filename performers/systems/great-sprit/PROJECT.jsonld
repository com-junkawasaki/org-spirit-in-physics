  "@id": "https://spirit-in-physics.gftd.ai/system/great-sprit",
  "@type": ["cpm:System", "dodaf:Performer", "prov:SoftwareAgent"],
  
  "name": "Great Spirit GPU Physics System",
  "title": "Great Spirit - Real-time Spirit Position Calculation with GPU Acceleration",
  "description": "物理法則に基づく「スピリット位置」のリアルタイム計算システム。開放系ダイナミクス、共振駆動、相殺メカニズムを統合し、wgpuでGPU並列処理を実現。大規模（N×P=10,000,000以上）に対応し、RDF/OWL知識グラフ（TerminusDB）と統合する。RDFグラフとSHACL Shapeをベクトル場として可視化し、物理ダイナミクスに統合する。",
  
  "goal": "リアルタイム（数ms/tick）×大規模（10^5〜10^6）×数式駆動によるスピリット位置の物理的計算",
  
  "narrative": [
    {
      "@id": "https://spirit-in-physics.gftd.ai/system/great-sprit/narrative/0",
      "@type": "cpm:Narrative",
      "act": "物理ダイナミクス",
      "summary": "開放系ダイナミクス ẍ = -∇U(s) - C·ṡ + α(ψ̄_𝒩(t) - s) + β·R(t) により、スピリット位置を物理法則に従って計算する。"
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/system/great-sprit/narrative/1",
      "@type": "cpm:Narrative",
      "act": "共振駆動",
      "summary": "離散帯域バンドパスフィルタ R(t) ≈ Σ_k Γ_k · (B_k * w)(t) により、世界の情報入力から共振を抽出し、相殺・増幅を実現する。"
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/system/great-sprit/narrative/2",
      "@type": "cpm:Narrative",
      "act": "GPU並列処理",
      "summary": "wgpuによる1ディスパッチ融合（BPF→共振→ODE）で、10万〜100万サンプルを0.5〜8ms/stepで処理する。"
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/system/great-sprit/narrative/3",
      "@type": "cpm:Narrative",
      "act": "RDF/OWL統合",
      "summary": "TerminusDBからKG埋め込みを読み込み、あなた中心変換 ψ(v) = φ(v) - φ(u*) により近傍重心を計算し、物理ダイナミクスに統合する。"
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/system/great-sprit/narrative/4",
      "@type": "cpm:Narrative",
      "act": "RDF/SHACLベクトル場可視化",
      "summary": "RDFトリプル（subject-predicate-object）をベクトル場として可視化し、SHACL Shapeの制約を力ベクトルとして表現する。これらを物理ダイナミクスに統合し、修正された式 ẍ = -∇U(s) - C·ṡ + α(ψ̄_𝒩(t) - s) + β·R(t) + γ·F_shacl(s) により、制約に従った動的挙動を実現する。"
    }
  ],
  
