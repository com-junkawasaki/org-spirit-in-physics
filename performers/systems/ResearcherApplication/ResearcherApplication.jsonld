  "id": "https://spirit-in-physics.gftd.ai/performer/system/ResearcherApplication",
  "type": "https://spirit-in-physics.gftd.ai/ontology#ResearcherApplication",
  "name": {
    "en": "Researcher Application",
    "ja": "研究者アプリケーション"
  },
  "description": {
    "en": "System performer for data visualization and analysis for researchers. Handles timeline integration, visualization, and analysis result presentation.",
    "ja": "研究者向けのデータ可視化と解析を行うシステム実行主体。時系列統合、可視化、解析結果提示を担当。"
