  "@graph": [
    {
      "@id": "https://spirit-in-physics.gftd.ai/system/database/capability/relational-modeling",
      "@type": "cpm:Capability",
      "name": "RelationalModelingCapability",
      "description": "リレーショナルデータモデリング能力。Participant、Experiment、Session、Response、WordStimulus、EmotionAggregation、PhysiologicalAggregation、KernelFusionRun、EmbeddingResultなどのテーブル構造を提供する。"
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/system/database/capability/transaction-management",
      "@type": "cpm:Capability",
      "name": "TransactionManagementCapability",
      "description": "トランザクション管理能力。ACID特性を保証し、データの一貫性と完全性を維持する。"
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/system/database/capability/data-protection",
      "@type": "cpm:Capability",
      "name": "DataProtectionCapability",
      "description": "データ保護能力。Row Level Security（RLS）ポリシーによるデータアクセス制御を提供する。"
    }
  ]
