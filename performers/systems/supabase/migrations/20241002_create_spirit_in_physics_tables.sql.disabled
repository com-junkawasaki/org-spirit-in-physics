-- Merkle DAG: Spirit is Physics データベーススキーマ
-- Supabase PostgreSQL用マイグレーション

-- 参加者テーブル
CREATE TABLE IF NOT EXISTS participants (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    signature TEXT NOT NULL,
    agreed_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    agreements JSONB DEFAULT '{}',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- セッションテーブル
CREATE TABLE IF NOT EXISTS sessions (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    participant_id UUID NOT NULL REFERENCES participants(id) ON DELETE CASCADE,
    events JSONB DEFAULT '[]',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- ビデオファイルテーブル
CREATE TABLE IF NOT EXISTS video_files (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    participant_id UUID NOT NULL REFERENCES participants(id) ON DELETE CASCADE,
    session_id UUID NOT NULL REFERENCES sessions(id) ON DELETE CASCADE,
    file_name TEXT NOT NULL,
    file_path TEXT NOT NULL,
    file_size BIGINT NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 感情分析テーブル
CREATE TABLE IF NOT EXISTS emotion_analyses (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    participant_id UUID NOT NULL REFERENCES participants(id) ON DELETE CASCADE,
    video_file_id UUID NOT NULL REFERENCES video_files(id) ON DELETE CASCADE,
    session_type TEXT NOT NULL,
    timestamp TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    processing_time_ms INTEGER NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 感情テーブル
CREATE TABLE IF NOT EXISTS emotions (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    analysis_id UUID NOT NULL REFERENCES emotion_analyses(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    score DOUBLE PRECISION NOT NULL,
    confidence DOUBLE PRECISION NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- インデックスの作成
CREATE INDEX IF NOT EXISTS idx_participants_signature ON participants(signature);
CREATE INDEX IF NOT EXISTS idx_participants_agreed_at ON participants(agreed_at);
CREATE INDEX IF NOT EXISTS idx_sessions_participant_id ON sessions(participant_id);
CREATE INDEX IF NOT EXISTS idx_sessions_created_at ON sessions(created_at);
CREATE INDEX IF NOT EXISTS idx_video_files_participant_id ON video_files(participant_id);
CREATE INDEX IF NOT EXISTS idx_video_files_session_id ON video_files(session_id);
CREATE INDEX IF NOT EXISTS idx_emotion_analyses_participant_id ON emotion_analyses(participant_id);
CREATE INDEX IF NOT EXISTS idx_emotion_analyses_video_file_id ON emotion_analyses(video_file_id);
CREATE INDEX IF NOT EXISTS idx_emotion_analyses_timestamp ON emotion_analyses(timestamp);
CREATE INDEX IF NOT EXISTS idx_emotions_analysis_id ON emotions(analysis_id);
CREATE INDEX IF NOT EXISTS idx_emotions_name ON emotions(name);

-- RLS (Row Level Security) の設定
ALTER TABLE participants ENABLE ROW LEVEL SECURITY;
ALTER TABLE sessions ENABLE ROW LEVEL SECURITY;
ALTER TABLE video_files ENABLE ROW LEVEL SECURITY;
ALTER TABLE emotion_analyses ENABLE ROW LEVEL SECURITY;
ALTER TABLE emotions ENABLE ROW LEVEL SECURITY;

-- 参加者データのアクセスポリシー
CREATE POLICY "Participants are viewable by everyone" ON participants
    FOR SELECT USING (true);

CREATE POLICY "Participants can be inserted by authenticated users" ON participants
    FOR INSERT WITH CHECK (true);

CREATE POLICY "Participants can be updated by authenticated users" ON participants
    FOR UPDATE USING (true);

-- セッションデータのアクセスポリシー
CREATE POLICY "Sessions are viewable by everyone" ON sessions
    FOR SELECT USING (true);

CREATE POLICY "Sessions can be inserted by authenticated users" ON sessions
    FOR INSERT WITH CHECK (true);

CREATE POLICY "Sessions can be updated by authenticated users" ON sessions
    FOR UPDATE USING (true);

-- ビデオファイルデータのアクセスポリシー
CREATE POLICY "Video files are viewable by everyone" ON video_files
    FOR SELECT USING (true);

CREATE POLICY "Video files can be inserted by authenticated users" ON video_files
    FOR INSERT WITH CHECK (true);

CREATE POLICY "Video files can be updated by authenticated users" ON video_files
    FOR UPDATE USING (true);

-- 感情分析データのアクセスポリシー
CREATE POLICY "Emotion analyses are viewable by everyone" ON emotion_analyses
    FOR SELECT USING (true);

CREATE POLICY "Emotion analyses can be inserted by authenticated users" ON emotion_analyses
    FOR INSERT WITH CHECK (true);

CREATE POLICY "Emotion analyses can be updated by authenticated users" ON emotion_analyses
    FOR UPDATE USING (true);

-- 感情データのアクセスポリシー
CREATE POLICY "Emotions are viewable by everyone" ON emotions
    FOR SELECT USING (true);

CREATE POLICY "Emotions can be inserted by authenticated users" ON emotions
    FOR INSERT WITH CHECK (true);

-- Updated at トリガーの作成
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ language 'plpgsql';

CREATE TRIGGER update_participants_updated_at BEFORE UPDATE ON participants
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

CREATE TRIGGER update_sessions_updated_at BEFORE UPDATE ON sessions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

CREATE TRIGGER update_video_files_updated_at BEFORE UPDATE ON video_files
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

CREATE TRIGGER update_emotion_analyses_updated_at BEFORE UPDATE ON emotion_analyses
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
