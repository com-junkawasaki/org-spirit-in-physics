  "@graph": [
    {
      "@id": "https://spirit-in-physics.gftd.ai/system/supabase",
      "@type": ["cpm:System", "dodaf:Performer", "prov:SoftwareAgent"],
      
      "name": "SupabasePlatform",
      "description": "Supabase プラットフォームシステム。PostgreSQL データベース、REST API、認証、リアルタイム、ストレージ、Edge Functions を統合した BaaS プラットフォーム。GraphQL API と統合し、構造化データモデリング、CRUD操作、トランザクション管理、データ保護、認証・認可、リアルタイム更新、ファイルストレージを提供する。",
      
      "providesCapability": [
        "https://spirit-in-physics.gftd.ai/capability/data-management",
        "https://spirit-in-physics.gftd.ai/capability/authentication",
        "https://spirit-in-physics.gftd.ai/capability/realtime",
        "https://spirit-in-physics.gftd.ai/capability/storage"
      ],
      
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/capability/data-management",
        "https://spirit-in-physics.gftd.ai/capability/authentication"
      ],
      
      "configuration": {
        "@id": "https://spirit-in-physics.gftd.ai/system/supabase/config",
        "@type": "cpm:Configuration",
        "projectId": "lawyer",
        "apiPort": 54321,
        "dbPort": 54322,
        "studioPort": 54323,
        "inbucketPort": 54324,
        "postgresVersion": "17",
        "features": {
          "api": true,
          "auth": true,
          "realtime": true,
          "storage": true,
          "studio": true,
          "edgeRuntime": true,
          "analytics": true
        }
      }
    }
  ]
