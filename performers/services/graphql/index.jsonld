{
  "@context": {
    "@version": 1.1,
    "id": "@id",
    "type": "@type",
    "cpm": "https://example.org/cpm#",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "sh": "http://www.w3.org/ns/shacl#",
    "dodaf": "http://dodaf.mil/dm2#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    
    "name": "rdfs:label",
    "description": "rdfs:comment",
    "wasAttributedTo": "prov:wasAttributedTo",
    "provides": "cpm:provides",
    "introspection": "cpm:introspection"
  },
  
  "@graph": [
    {
      "@id": "https://spirit-in-physics.gftd.ai/service/graphql",
      "@type": ["cpm:Service", "dodaf:Performer", "prov:SoftwareAgent"],
      
      "name": "GraphQLService",
      "description": "Rust GraphQL API（async-graphql）。GraphQL APIのintrospectionとSDL生成を提供し、データ管理、感情分析、分析能力を提供する。code-firstアプローチにより、RustコードからSDLを自動生成し、TypeScript型定義を自動生成するパイプラインを実装。",
      
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/capability/data-management",
        "https://spirit-in-physics.gftd.ai/capability/emotion-analysis",
        "https://spirit-in-physics.gftd.ai/capability/analysis"
      ],
      
      "introspection": {
        "@id": "https://spirit-in-physics.gftd.ai/service/graphql/introspection",
        "@type": "cpm:Introspection",
        "endpoint": "http://localhost:8080/graphql",
        "playground": "http://localhost:8080/playground",
        "sdlEndpoint": "http://localhost:8080/graphql/sdl",
        "sdlFile": "schema.graphql",
        "codegen": {
          "enabled": true,
          "targets": ["typescript", "typed-document-node"],
          "config": "codegen.yaml"
        }
      },
      
      "provides": [
        {
          "@id": "https://spirit-in-physics.gftd.ai/service/graphql/capability/data-management",
          "@type": "cpm:Capability"
        },
        {
          "@id": "https://spirit-in-physics.gftd.ai/service/graphql/capability/emotion-analysis",
          "@type": "cpm:Capability"
        },
        {
          "@id": "https://spirit-in-physics.gftd.ai/service/graphql/capability/analysis",
          "@type": "cpm:Capability"
        }
      ]
    }
  ]
}

