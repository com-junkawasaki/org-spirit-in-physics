@prefix spirit: <https://spirit-in-physics.gftd.ai/ontology#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Merkle DAG: shapes.timeline_dataflow
# タイムラインデータフローのSHACL形状定義

# ============================================================================
# TimelineIntegrationProcess形状（詳細）
# ============================================================================

spirit:TimelineIntegrationProcessShape a sh:NodeShape ;
    sh:targetClass spirit:TimelineIntegrationProcess ;
    sh:name "Timeline Integration Process Shape"@en, "時系列統合プロセス形状"@ja ;
    sh:description "時系列統合プロセスの詳細形状定義"@ja ;
    sh:property [
        sh:path spirit:hasInput ;
        sh:class spirit:SessionEvent ;
        sh:minCount 1 ;
        sh:message "TimelineIntegrationProcess must have at least one SessionEvent input"@en ;
    ] ;
    sh:property [
        sh:path spirit:hasInput ;
        sh:class spirit:EmotionData ;
        sh:minCount 0 ;
        sh:message "TimelineIntegrationProcess may have EmotionData input"@en ;
    ] ;
    sh:property [
        sh:path spirit:hasInput ;
        sh:class spirit:PhysiologicalData ;
        sh:minCount 0 ;
        sh:message "TimelineIntegrationProcess may have PhysiologicalData input"@en ;
    ] ;
    sh:property [
        sh:path spirit:hasOutput ;
        sh:class spirit:TimelineData ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "TimelineIntegrationProcess must have exactly one TimelineData output"@en ;
    ] ;
    sh:property [
        sh:path spirit:transforms ;
        sh:class spirit:TimeRangeMatchingTransformation, 
                    spirit:EmotionDataIntegrationTransformation,
                    spirit:PhysiologicalDataIntegrationTransformation,
                    spirit:TimelineDataPointCreationTransformation ;
        sh:minCount 1 ;
        sh:message "TimelineIntegrationProcess must have at least one transformation"@en ;
    ] .

# ============================================================================
# TimeRangeMatchingTransformation形状
# ============================================================================

spirit:TimeRangeMatchingTransformationShape a shacl:NodeShape ;
    sh:targetClass spirit:TimeRangeMatchingTransformation ;
    sh:name "Time Range Matching Transformation Shape"@en, "時間範囲マッチング変換形状"@ja ;
    sh:description "時間範囲マッチング変換の形状定義"@ja ;
    sh:property [
        sh:path spirit:hasInput ;
        sh:class spirit:SessionEvent, spirit:EmotionData ;
        sh:minCount 2 ;
        sh:message "TimeRangeMatchingTransformation must have SessionEvent and EmotionData inputs"@en ;
    ] ;
    sh:property [
        sh:path spirit:hasOutput ;
        sh:nodeKind shacl:IRIOrLiteral ;
        sh:minCount 1 ;
        sh:message "TimeRangeMatchingTransformation must have output"@en ;
    ] .

# 時間範囲マッチング条件の検証
spirit:TimeRangeMatchingConditionShape a shacl:NodeShape ;
    sh:targetClass spirit:timeRangeMatchingCondition ;
    sh:name "Time Range Matching Condition Shape"@en, "時間範囲マッチング条件形状"@ja ;
    sh:description "時間範囲マッチング条件: emotion.beginTime <= relativeTimestamp <= emotion.endTime"@ja ;
    sh:property [
        sh:path ( spirit:hasBeginTime | spirit:hasStartTime ) ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "TimeRangeMatchingCondition must have beginTime"@en ;
    ] ;
    sh:property [
        sh:path ( spirit:hasEndTime | spirit:hasFinishTime ) ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "TimeRangeMatchingCondition must have endTime"@en ;
    ] .

# ============================================================================
# EmotionDataIntegrationTransformation形状
# ============================================================================

spirit:EmotionDataIntegrationTransformationShape a shacl:NodeShape ;
    sh:targetClass spirit:EmotionDataIntegrationTransformation ;
    sh:name "Emotion Data Integration Transformation Shape"@en, "感情データ統合変換形状"@ja ;
    sh:description "感情データ統合変換の形状定義"@ja ;
    sh:property [
        sh:path spirit:hasInput ;
        sh:class spirit:EmotionData ;
        sh:minCount 1 ;
        sh:message "EmotionDataIntegrationTransformation must have EmotionData input"@en ;
    ] ;
    sh:property [
        sh:path spirit:hasOutput ;
        sh:class spirit:EmotionDetail ;
        sh:minCount 1 ;
        sh:message "EmotionDataIntegrationTransformation must produce EmotionDetail array"@en ;
    ] .

# ============================================================================
# PhysiologicalDataIntegrationTransformation形状
# ============================================================================

spirit:PhysiologicalDataIntegrationTransformationShape a shacl:NodeShape ;
    sh:targetClass spirit:PhysiologicalDataIntegrationTransformation ;
    sh:name "Physiological Data Integration Transformation Shape"@en, "生理データ統合変換形状"@ja ;
    sh:description "生理データ統合変換の形状定義"@ja ;
    sh:property [
        sh:path spirit:hasInput ;
        sh:class spirit:PhysiologicalData ;
        sh:minCount 1 ;
        sh:message "PhysiologicalDataIntegrationTransformation must have PhysiologicalData input"@en ;
    ] ;
    sh:property [
        sh:path spirit:hasOutput ;
        sh:class spirit:PhysiologicalValues ;
        sh:minCount 1 ;
        sh:message "PhysiologicalDataIntegrationTransformation must produce PhysiologicalValues object"@en ;
    ] .

# ============================================================================
# TimelineDataPointCreationTransformation形状
# ============================================================================

spirit:TimelineDataPointCreationTransformationShape a shacl:NodeShape ;
    sh:targetClass spirit:TimelineDataPointCreationTransformation ;
    sh:name "Timeline Data Point Creation Transformation Shape"@en, "時系列データポイント作成変換形状"@ja ;
    sh:description "時系列データポイント作成変換の形状定義"@ja ;
    sh:property [
        sh:path spirit:hasInput ;
        sh:class spirit:SessionEvent ;
        sh:minCount 1 ;
        sh:message "TimelineDataPointCreationTransformation must have SessionEvent input"@en ;
    ] ;
    sh:property [
        sh:path spirit:hasInput ;
        sh:class spirit:EmotionDetail ;
        sh:minCount 0 ;
        sh:message "TimelineDataPointCreationTransformation may have EmotionDetail input"@en ;
    ] ;
    sh:property [
        sh:path spirit:hasInput ;
        sh:class spirit:PhysiologicalValues ;
        sh:minCount 0 ;
        sh:message "TimelineDataPointCreationTransformation may have PhysiologicalValues input"@en ;
    ] ;
    sh:property [
        sh:path spirit:hasOutput ;
        sh:class spirit:TimelineData ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "TimelineDataPointCreationTransformation must produce exactly one TimelineData"@en ;
    ] .

# ============================================================================
# SupabaseToResearcherTimelineFlow形状
# ============================================================================

spirit:SupabaseToResearcherTimelineFlowShape a shacl:NodeShape ;
    sh:targetClass spirit:SupabaseToResearcherTimelineFlow ;
    sh:name "Supabase to Researcher Timeline Flow Shape"@en, "Supabaseから研究者タイムラインへのフロー形状"@ja ;
    sh:description "Supabaseから3D-Force-Timelineへのデータフローの形状定義"@ja ;
    sh:property [
        sh:path spirit:hasInput ;
        sh:nodeKind shacl:IRIOrLiteral ;
        sh:in ([ a owl:NamedIndividual ; 
                    rdfs:label "participant_session_events table"@en ;
                    rdf:type owl:NamedIndividual ]
                  [ a owl:NamedIndividual ; 
                    rdfs:label "participant_hume_*_predictions tables"@en ;
                    rdf:type owl:NamedIndividual ]
                  [ a owl:NamedIndividual ; 
                    rdfs:label "response_skin_potential_timeseries table"@en ;
                    rdf:type owl:NamedIndividual ]) ;
        sh:minCount 1 ;
        sh:message "SupabaseToResearcherTimelineFlow must have at least one Supabase table input"@en ;
    ] ;
    sh:property [
        sh:path spirit:hasOutput ;
        sh:hasValue [ a owl:NamedIndividual ; 
                        rdfs:label "3D Force Timeline Visualization"@en ;
                        rdf:type owl:NamedIndividual ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "SupabaseToResearcherTimelineFlow must produce 3D Force Timeline Visualization"@en ;
    ] .

# ============================================================================
# プロセス実行順序の検証
# ============================================================================

spirit:ProcessExecutionOrderShape a shacl:NodeShape ;
    sh:targetClass spirit:Process ;
    sh:name "Process Execution Order Shape"@en, "プロセス実行順序形状"@ja ;
    sh:description "プロセスの実行順序が正しいことを検証"@ja ;
    sh:property [
        sh:path spirit:hasPrecedingStep ;
        sh:class spirit:Process ;
        sh:minCount 0 ;
        sh:message "Process may have preceding steps"@en ;
    ] ;
    sh:property [
        sh:path spirit:hasFollowingStep ;
        sh:class spirit:Process ;
        sh:minCount 0 ;
        sh:message "Process may have following steps"@en ;
    ] .

# TimelineIntegrationProcessの実行順序検証
spirit:TimelineIntegrationProcessOrderShape a shacl:NodeShape ;
    sh:targetClass spirit:TimelineIntegrationProcess ;
    sh:name "Timeline Integration Process Order Shape"@en, "時系列統合プロセス順序形状"@ja ;
    sh:description "TimelineIntegrationProcessの実行順序を検証"@ja ;
    sh:property [
        sh:path spirit:hasPrecedingStep ;
        sh:class spirit:SessionDataRetrievalStep, 
                    spirit:EmotionDataRetrievalStep,
                    spirit:PhysiologicalDataRetrievalStep ;
        sh:minCount 1 ;
        sh:message "TimelineIntegrationProcess must have at least one data retrieval step as preceding step"@en ;
    ] ;
    sh:property [
        sh:path spirit:hasFollowingStep ;
        sh:class spirit:TimelineVisualizationStep ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "TimelineIntegrationProcess may have TimelineVisualizationStep as following step"@en ;
    ] .

