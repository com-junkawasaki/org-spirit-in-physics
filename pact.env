# Pact Broker Configuration for Local Development
PACT_BROKER_BASE_URL=http://localhost:9292
PACT_BROKER_USERNAME=admin
PACT_BROKER_PASSWORD=password
PACT_BROKER_READONLY_USERNAME=readonly
PACT_BROKER_READONLY_PASSWORD=password

# Development settings
PACT_BROKER_ALLOW_PUBLIC_READ=true
PACT_BROKER_WEBHOOK_SCHEME_WHITELIST=http
PACT_BROKER_WEBHOOK_HOST_WHITELIST=localhost

# Database settings
PACT_BROKER_DATABASE_URL=postgresql://postgres:password@pact-postgres:5432/pact_broker
