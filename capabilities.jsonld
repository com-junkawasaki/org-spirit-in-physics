    "dodaf": "http://dodaf.mil/dm2#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    
    "name": "rdfs:label",
    "description": "rdfs:comment",
    "wasAttributedTo": "prov:wasAttributedTo",
    "enables": "cpm:enables"
  },
  
  "@graph": [
    {
      "@id": "https://spirit-in-physics.gftd.ai/capability/spirit-measurement",
      "@type": ["cpm:Capability", "dodaf:Capability"],
      "name": "SpiritMeasurementCapability",
      "description": "霊性測定能力。川崎モデルによるWord2Vec、反応時間、生理データ、感情データの統合分析により、参加者の「spirit」を確率値とベクトルとして可視化・測定可能にする。",
      "enables": [
        "https://spirit-in-physics.gftd.ai/activity/kawasaki-model-analysis"
      ],
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/service/graphql",
        "https://spirit-in-physics.gftd.ai/actor/researcher"
      ]
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/capability/emotion-analysis",
      "@type": ["cpm:Capability", "dodaf:Capability"],
      "name": "EmotionAnalysisCapability",
      "description": "感情分析能力。Hume AI統合による感情データ処理、48種類のHume感情を標準7感情カテゴリにマッピング、感情価と感情強度の計算。",
      "enables": [
        "https://spirit-in-physics.gftd.ai/activity/emotion-analysis"
      ],
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/service/graphql"
      ]
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/capability/data-management",
      "@type": ["cpm:Capability", "dodaf:Capability"],
      "name": "DataManagementCapability",
      "description": "データ管理能力。GraphQL APIとPostgreSQL統合による構造化データモデリング、CRUD操作、トランザクション管理、データ保護。SupabaseプラットフォームによるREST API、リアルタイム更新、ストレージ機能も提供。",
      "enables": [
        "https://spirit-in-physics.gftd.ai/activity/data-import",
        "https://spirit-in-physics.gftd.ai/activity/participant-registration"
      ],
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/service/graphql",
        "https://spirit-in-physics.gftd.ai/system/supabase"
      ]
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/capability/authentication",
      "@type": ["cpm:Capability", "dodaf:Capability"],
      "name": "AuthenticationCapability",
      "description": "認証・認可能力。Supabase Authによるユーザー認証、セッション管理、JWT トークン発行、OAuth プロバイダー統合、メール認証、匿名サインイン。",
      "enables": [
        "https://spirit-in-physics.gftd.ai/activity/user-authentication",
        "https://spirit-in-physics.gftd.ai/activity/session-management"
      ],
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/system/supabase"
      ]
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/capability/realtime",
      "@type": ["cpm:Capability", "dodaf:Capability"],
      "name": "RealtimeCapability",
      "description": "リアルタイム能力。Supabase Realtimeによるデータベース変更のリアルタイム購読、WebSocket接続、チャンネル管理、プレゼンス機能。",
      "enables": [
        "https://spirit-in-physics.gftd.ai/activity/realtime-updates",
        "https://spirit-in-physics.gftd.ai/activity/live-dashboard"
      ],
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/system/supabase"
      ]
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/capability/storage",
      "@type": ["cpm:Capability", "dodaf:Capability"],
      "name": "StorageCapability",
      "description": "ストレージ能力。Supabase Storageによるファイルアップロード・ダウンロード、バケット管理、アクセス制御、画像変換API。",
      "enables": [
        "https://spirit-in-physics.gftd.ai/activity/file-upload",
        "https://spirit-in-physics.gftd.ai/activity/media-management"
      ],
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/system/supabase"
      ]
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/capability/visualization",
      "@type": ["cpm:Capability", "dodaf:Capability"],
      "name": "VisualizationCapability",
      "description": "可視化能力。3D可視化（感情距離フォース、テンセグリティ物理）、時系列可視化（セッションデータ、生理データ、感情データ統合）、インタラクティブダッシュボード。",
      "enables": [
        "https://spirit-in-physics.gftd.ai/activity/visualization"
      ],
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/service/visualizer",
        "https://spirit-in-physics.gftd.ai/actor/researcher"
      ]
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/capability/experiment-management",
      "@type": ["cpm:Capability", "dodaf:Capability"],
      "name": "ExperimentManagementCapability",
      "description": "実験管理能力。参加者管理、セッション管理、同意管理、実験データのインポート・分析・可視化の統合ワークフロー。",
      "enables": [
        "https://spirit-in-physics.gftd.ai/activity/experiment-session",
        "https://spirit-in-physics.gftd.ai/activity/consent-management"
      ],
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/actor/researcher",
        "https://spirit-in-physics.gftd.ai/organization/research-org"
      ]
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/capability/analysis",
      "@type": ["cpm:Capability", "dodaf:Capability"],
      "name": "AnalysisCapability",
      "description": "分析能力。Word2Vecによる意味的類似性分析、生理データ分析（皮膚電位時系列）、相関分析（ピアソン・スピアマン相関係数）、時系列分析。",
      "enables": [
        "https://spirit-in-physics.gftd.ai/activity/kawasaki-model-analysis",
        "https://spirit-in-physics.gftd.ai/activity/report-generation"
      ],
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/service/graphql",
        "https://spirit-in-physics.gftd.ai/actor/researcher"
      ]
    },
    {
      "@id": "https://spirit-in-physics.gftd.ai/capability/type-generation",
      "@type": ["cpm:Capability", "dodaf:Capability"],
      "name": "TypeGenerationCapability",
      "description": "型生成能力。Rust code-first GraphQL (async-graphql)からSDLを自動生成し、GraphQL CodegenによりTypeScript型定義とTyped Document Nodeを自動生成する。.graphqlファイルによるGraphQLドキュメント定義をサポートし、エンドツーエンドの型安全性を実現する。",
      "enables": [
        "https://spirit-in-physics.gftd.ai/activity/type-generation",
        "https://spirit-in-physics.gftd.ai/activity/schema-generation"
      ],
      "wasAttributedTo": [
        "https://spirit-in-physics.gftd.ai/service/graphql",
        "https://spirit-in-physics.gftd.ai/actor/researcher",
        "https://spirit-in-physics.gftd.ai/actor/visualizer",
        "https://spirit-in-physics.gftd.ai/actor/participant"
      ]
    }
  ]
}

